  <h1>Position Record</h1>

  <h2>Open</h2>
  <div class="scroller">
  <table class="book" id="book">
    <thead><tr>
      <th data-sort="name" data-dir="asc">Position</th>
      <th data-sort="side" data-dir="asc">Dir</th>
      <th class="n">Entry</th><th class="n">Stop</th><th class="n">Target</th>
      <th class="n">Last</th>
      <th class="n" data-sort="carry" data-dir="desc">Carry</th>
      <th class="n" data-sort="left" data-dir="asc">To stop</th>
      <th class="n" data-sort="r" data-dir="desc">R</th>
    </tr></thead>
{% for p in rows %}    <tbody class="pos" data-name="{{ p.name }}" data-side="{{ p.direction }}"
        data-opened="{{ p.entry_date }}" data-carry="{{ p.carry_pct }}"
        data-left="{{ p.stop_left }}" data-r="{{ p.r }}">
      <tr>
        <td><span class="nm">{{ p.name }}</span><span class="kind">{{ p.kind }} &middot; opened {{ p.entry_date }}</span></td>
        <td><span class="dir {{ p.direction | lower }}">{{ p.direction }}</span></td>
        <td class="n">{{ p.entry | px(p.dp) }}</td>
        <td class="n">{{ p.stop | px(p.dp) }}</td>
        <td class="n">{{ p.target | px(p.dp) }} <span class="sub">{{ '%.1f'|format(p.reward_r) }}R</span></td>
        <td class="n">{{ p.price | px(p.dp) }}</td>
        <td class="n carry {{ 'rx' if p.carry_dir == 'received' else 'px' }}">{{ '%+.2f'|format(p.carry_pct) }}%</td>
        <td class="n">{{ '%.2f'|format(p.stop_left) }}R</td>
        <td class="n r {{ 'up' if p.r >= 0 else 'dn' }}">{{ '%+.2f'|format(p.r) }}</td>
      </tr>
      <tr class="why"><td colspan="9"><ul>
{% for line in p.thesis %}        <li>{{ line }}</li>
{% endfor %}      </ul></td></tr>
    </tbody>
{% endfor %}  </table>
  </div>

