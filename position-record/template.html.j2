  .rec .na { color: var(--faint); font-style: italic; font-size: 11.5px; }
  .scroller { overflow-x: auto; }

  @media (max-width: 680px) {
    .wrap { padding-top: 1.6rem; }
    .bar { margin-bottom: 2.6rem; }
    /* The R loses its auto margin: alone on a line it would sit against the right
