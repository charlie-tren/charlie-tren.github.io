  .r.up { color: var(--pos); } .r.dn { color: var(--neg); }

  .why { margin: 1.1rem 0 1.3rem; padding: 0; list-style: none; max-width: 62ch; }
  .why li { position: relative; padding-left: 1.1rem; margin-bottom: .6rem; color: var(--ink); }
  .why li::before { content: ""; position: absolute; left: 0; top: .72em;
                    width: 5px; height: 1px; background: var(--faint); }
  .why li:last-child { margin-bottom: 0; }

  .figs { display: flex; flex-wrap: wrap; gap: .35rem 1.6rem;
          font: 400 12.5px/1.5 ui-monospace, Consolas, monospace; color: var(--soft); }
  .figs b { font-weight: 400; color: var(--faint); letter-spacing: .06em;
