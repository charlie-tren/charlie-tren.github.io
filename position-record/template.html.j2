<body>
<div class="wrap">
  <div class="bar">
    <a class="home" href="https://charlietrenorden.com/"><span class="back">&larr;</span>Other projects</a>
    <button class="toggle" id="themeBtn" type="button" aria-label="Toggle light and dark theme"><span class="dot"></span><span id="themeLbl">Dark</span></button>
  </div>

  <nav class="tabs" aria-label="Sections">
    <a class="tab" href="/research/">Equity Research</a>
    <a class="tab" href="/position-record/" aria-current="page">Position Record</a>
  </nav>

  <h1>Position Record</h1>
  <p class="lede">Every position, open and closed, with the reasoning recorded at entry.</p>

  <div class="scroller">
  <table class="book" id="book">
    <thead><tr>
      <th data-sort="name" data-dir="asc">Position</th>
      <th data-sort="kind" data-dir="asc">Type</th>
      <th data-sort="opened" data-dir="desc">Opened</th>
      <th data-sort="side" data-dir="asc">Dir</th>
      <th class="n" data-sort="entry" data-dir="asc">Entry</th>
      <th class="n" data-sort="stopat" data-dir="asc">Stop</th>
      <th class="n" data-sort="carry" data-dir="desc">Carry</th>
      <th class="n" data-sort="progress" data-dir="desc">Progress</th>
      <th class="n" data-sort="r" data-dir="desc">R</th>
      <th></th>
    </tr></thead>
{% for p in rows %}    <tbody class="pos" data-name="{{ p.name }}" data-side="{{ p.direction }}"
        data-opened="{{ p.entry_date }}" data-carry="{{ p.carry_pct }}" data-kind="{{ p.kind }}"
        data-progress="{{ p.progress }}" data-r="{{ p.r }}"
        data-entry="{{ p.entry }}" data-stopat="{{ p.stop }}"
>
      <tr>
        <td style="white-space:normal"><span class="nm">{{ p.name }}</span></td>
        <td class="kind">{{ p.kind }}</td>
        <td class="q">{{ p.opened }}</td>
        <td><span class="dir {{ p.direction | lower }}">{{ p.direction }}</span></td>
        <td class="n q">{{ p.entry | px(p.dp, p.ccy) }}</td>
        <td class="n q">{{ p.stop | px(p.dp, p.ccy) }}</td>
        <td class="n">{{ '%+.2f'|format(p.carry_pct) }}%</td>
        <td class="n">{{ '%.0f'|format(p.progress) }}%</td>
        <td class="n r {{ 'up' if p.r >= 0 else 'dn' }}">{{ '%+.2f'|format(p.r) }}</td>
        <td class="n"><button class="thesis" type="button" aria-expanded="true">Thesis</button></td>
      </tr>
      <tr class="why"><td colspan="10"><dl>
        <dt>Thesis</dt><dd>{{ p.thesis }}</dd>
        <dt>Catalyst</dt><dd>{{ p.catalyst }}</dd>
        <dt>Breaks if</dt><dd>{{ p.breaks }}</dd>
      </dl></td></tr>
    </tbody>
{% endfor %}  </table>
  </div>

{% if closed %}
  <h2>Closed</h2>
  <div class="scroller">
  <table class="book">
    <thead><tr>
      <th>Position</th><th>Dir</th><th class="n">R</th>
    </tr></thead>
    <tbody>
{% for c in closed %}      <tr>
        <td><span class="nm">{{ c.name }}</span><span class="kind">{{ c.entry_date }} to {{ c.exit_date }}</span></td>
        <td><span class="dir {{ c.direction | lower }}">{{ c.direction }}</span></td>
        <td class="n r {{ 'up' if c.r >= 0 else 'dn' }}">{{ '%+.2f'|format(c.r) }}</td>
      </tr>
      <tr class="why"><td colspan="3"><ul>
{% for line in c.thesis %}        <li>{{ line }}</li>
{% endfor %}        <li>{{ c.outcome }}</li>
      </ul></td></tr>
{% endfor %}    </tbody>
  </table>
  </div>
{% endif %}

</div>

<script>
  /* Sorting reorders whole tbodies, so a position keeps its reasoning with it. */
  (function () {
    var t = document.getElementById("book");
    if (!t || !t.tHead) return;

    [].forEach.call(t.querySelectorAll("tbody.pos"), function (tb) {
      var btn = tb.querySelector(".thesis"), row = tb.querySelector("tr.why");
      if (!btn || !row) return;
      tb._set = function (open) {
        btn.setAttribute("aria-expanded", open ? "true" : "false");
        row.hidden = !open;
        tb.classList.toggle("shut", !open);
      };
      tb._set(false);
      btn.addEventListener("click", function () {
        var open = btn.getAttribute("aria-expanded") !== "true";
        /* One at a time: two open theses push the rest of the book off the screen. */
        [].forEach.call(t.querySelectorAll("tbody.pos"), function (o) {
          if (o._set) o._set(o === tb && open);
        });
      });
    });

    var heads = [].slice.call(t.tHead.rows[0].cells);
    function val(tb, k) {
      var v = tb.getAttribute("data-" + k), n = parseFloat(v);
      return isNaN(n) ? String(v).toLowerCase() : n;
    }
    function sort(th) {
      var first = th.getAttribute("data-dir") === "asc" ? "ascending" : "descending";
      var other = first === "ascending" ? "descending" : "ascending";
      var dir = th.getAttribute("aria-sort") === first ? other : first;
      heads.forEach(function (c) { c.removeAttribute("aria-sort"); });
      th.setAttribute("aria-sort", dir);
      var k = th.getAttribute("data-sort"), s = dir === "ascending" ? 1 : -1;
      [].slice.call(t.tBodies).sort(function (a, b) {
        var x = val(a, k), y = val(b, k);
        return x < y ? -s : x > y ? s : 0;
      }).forEach(function (tb) { t.appendChild(tb); });
    }
    heads.forEach(function (th) {
      if (!th.getAttribute("data-sort")) return;
      th.tabIndex = 0;
      th.addEventListener("click", function () { sort(th); });
      th.addEventListener("keydown", function (ev) {
        if (ev.key === "Enter" || ev.key === " ") { ev.preventDefault(); sort(th); }
      });
    });
  })();

  var root = document.documentElement;
  var btn = document.getElementById("themeBtn"), lbl = document.getElementById("themeLbl");
  function sync() { lbl.textContent = root.getAttribute("data-theme") === "dark" ? "Dark" : "Light"; }
  sync();
  btn.addEventListener("click", function () {
    var dark = root.getAttribute("data-theme") !== "dark";
    root.setAttribute("data-theme", dark ? "dark" : "light");
    try { localStorage.setItem("theme", dark ? "dark" : "light"); } catch (e) {}
    sync();
  });
</script>
</body>
