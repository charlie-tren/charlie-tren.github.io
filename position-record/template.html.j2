            font-size: 10.5px; padding-right: .4rem; }
  .figs .carry.rx { color: var(--pos); }
  .figs .carry.px { color: var(--neg); }

  /* Distance left to the stop, as a share of the original risk. A bar rather than a
     number because the thing a reader wants is whether it is nearly gone. */
  .gauge { margin-top: .9rem; max-width: 22rem; }
  .gauge .track { height: 3px; background: var(--rule); border-radius: 2px; overflow: hidden; }
  .gauge .fill { height: 100%; background: var(--accent); }
  .gauge .cap { display: block; margin-top: .4rem; font: 400 11px/1 ui-sans-serif, system-ui, sans-serif;
