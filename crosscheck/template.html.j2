  thead th .ar { color: var(--faint); margin-left: .3rem; font-size: 9px; }
  thead th[aria-sort] .ar { color: var(--accent); }
  tbody tr:last-child td { border-bottom: 0; }
  tbody tr:hover td { background: var(--motif-bg); }
