  col.c-tick { width: 5.5rem; }  col.c-name { width: 30%; }
  col.c-sect { width: 13%; }     col.c-score { width: 6rem; }
  col.c-tests { width: 5rem; }   col.c-gap { width: 6rem; }
  col.c-read { width: 6rem; }    col.c-cap { width: 7rem; }
  col.c-dcf { width: 6rem; }
  .tick { font-weight: 500; }
  /* On a phone the ticker moves INSIDE the company cell. Five columns need 376px of
     declared width against 358px of content, so the name column was being squeezed to
