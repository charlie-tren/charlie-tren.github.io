<body>
<div class="wrap">
  <div class="bar">
    <nav class="nav">
      <!-- The three sites this page is built from. They each carry a Crosscheck link in
           their own nav, so this is the return leg - without it the estate links one
           way only. No arrows: those mean up a level and these go sideways. -->
      <a class="home sib" href="https://charlietrenorden.com/shortfall/">Shortfall</a>
      <a class="home sib" href="https://charlietrenorden.com/consensus-drift/">Consensus Drift</a>
      <a class="home sib" href="https://dcf.charlietrenorden.com/">DCF Studio</a>
      <a class="home" href="https://charlietrenorden.com/"><span class="back">&larr;</span>Other projects</a>
    </nav>
    <button class="toggle" id="themeBtn" type="button" aria-label="Toggle light and dark theme"><span class="dot"></span><span id="themeLbl">Dark</span></button>
  </div>

  <h1>Crosscheck</h1>
  <p class="lede">{{ n }} companies ranked on accounting quality, estimate revisions, valuation and momentum, at weights you set.</p>

  <!-- Three charts, chosen from thirteen rendered on the live rows. All three are
       aria-hidden and the table below carries every value they draw: they are
       readings of the table, not the data. -->
  <!-- One chart at a time. Three side by side at 340px each was the case the site
       style already names - several small charts become unreadable - and its answer is
       a way to flick between larger ones. The segmented control IS the chart title, so
       the figures carry none of their own. All three are aria-hidden; the table below
       holds every value they draw. -->
  <div class="segmented" id="chartpick" role="group" aria-label="Choose a chart">
    <button type="button" data-chart="heat" aria-pressed="true"><span class="hfull">Sector Heatmap</span><span class="hshort">Heatmap</span></button>
    <button type="button" data-chart="sect" aria-pressed="false"><span class="hfull">Score by Sector</span><span class="hshort">By Sector</span></button>
    <button type="button" data-chart="hist" aria-pressed="false"><span class="hfull">Score Distribution</span><span class="hshort">Distribution</span></button>
    {% if has_moves %}<button type="button" data-chart="move" aria-pressed="false"><span class="hfull">Move Since Scored</span><span class="hshort">Move</span></button>
    <button type="button" data-chart="m1" aria-pressed="false"><span class="hfull">Forward Move by Quintile</span><span class="hshort">Forward</span></button>{% endif %}
  </div>
  <div class="charts">
    <figure class="ch" id="fig-heat">
      <svg id="heat" aria-hidden="true"></svg>
      <div class="key" id="heatkey"></div>
    </figure>
    <figure class="ch" id="fig-sect" hidden>
      <svg id="sect" aria-hidden="true"></svg>
    </figure>
    <figure class="ch" id="fig-hist" hidden>
      <svg id="hist" aria-hidden="true"></svg>
    </figure>
    {% if has_moves %}<figure class="ch" id="fig-m1" hidden>
      <div class="m1bar"><div class="segmented hz" id="m1pick" role="group" aria-label="Period">
        <button type="button" data-p="1" aria-pressed="true">1 month</button>
        <button type="button" data-p="6" aria-pressed="false">6 months</button>
      </div></div>
      <svg id="m1" aria-hidden="true"></svg>
      <div class="key" id="m1key"></div>
    </figure>
    <figure class="ch" id="fig-move" hidden>
      <svg id="move" aria-hidden="true"></svg>
      <div class="key" id="movekey"></div>
    </figure>{% endif %}
    <div class="tip" id="tip" hidden></div>
  </div>

  <div class="controls">
    <span class="wl">Horizon</span>
    <div class="hzline">
      <div class="segmented hz" id="horizon" role="group" aria-label="Horizon">
        <button type="button" data-h="short" aria-pressed="true"><span class="hfull">1 month</span><span class="hshort">1 mo</span></button>
        <button type="button" data-h="medium" aria-pressed="false"><span class="hfull">6 months</span><span class="hshort">6 mo</span></button>
        <button type="button" data-h="long" aria-pressed="false"><span class="hfull">2 years</span><span class="hshort">2 yr</span></button>
      </div>
      <!-- Even is a preset like the horizons, so it wears the same pill at the same size. -->
      <div class="segmented hz" role="group" aria-label="Equal weights">
        <button type="button" id="wReset" aria-pressed="false">Even</button>
      </div>
    </div>
    <span class="wl top">Weights</span>
    <!-- Each measure is oriented so MORE WEIGHT favours the better reading: a slider on
         Accounting Quality pulls toward clean accounts, never toward Shortfall's raw
         strain score, which runs the other way. -->
    <div class="wgrid">
      <div class="wc"><div class="wlab"><label for="wStrain">Accounting Quality</label><span class="info" tabindex="0" role="button" aria-label="About Accounting Quality">i<span class="itip" role="tooltip">Shortfall's six accounting tests, ranked within sector. Cleaner accounts score higher. Rebuilt back to 2021 for US companies from the SEC filings public at each date; ASX companies only from 12 Sep 2026.</span></span></div>
        <div class="wrow"><input type="range" id="wStrain" min="0" max="100" step="5" value="20"><b id="wStrainV">20%</b></div></div>
      <div class="wc"><div class="wlab"><label for="wDrift">Estimate Revisions</label><span class="info" tabindex="0" role="button" aria-label="About Estimate Revisions">i<span class="itip" role="tooltip">From Consensus Drift: analysts raising earnings estimates while the share price has not caught up. Both have to hold to score high.</span></span></div>
        <div class="wrow"><input type="range" id="wDrift" min="0" max="100" step="5" value="50"><b id="wDriftV">50%</b></div></div>
      <div class="wc"><div class="wlab"><label for="wDcf">Valuation</label><span class="info" tabindex="0" role="button" aria-label="About Valuation">i<span class="itip" role="tooltip">DCF Studio's value per share against the price, ranked within sector. Cheaper scores higher. No record before 12 Sep 2026, so on Move Since Scored it only shapes the weeks since.</span></span></div>
        <div class="wrow"><input type="range" id="wDcf" min="0" max="100" step="5" value="0"><b id="wDcfV">0%</b></div></div>
      <div class="wc"><div class="wlab"><label for="wMom">Price Momentum</label><span class="info" tabindex="0" role="button" aria-label="About Price Momentum">i<span class="itip" role="tooltip">The share price over the past year, ranked within each exchange. A stronger year scores higher.</span></span></div>
        <div class="wrow"><input type="range" id="wMom" min="0" max="100" step="5" value="30"><b id="wMomV">30%</b></div></div>
    </div>
  </div>

  <div class="toolbar">
    <input class="search" id="q" type="search" placeholder="Ticker or company" aria-label="Find a company">
    <label class="chk"><input type="checkbox" id="onlyAll" checked>
      Only names scored on all four</label>
    <button class="clear" id="clear" type="button" hidden>Clear</button>
    <span class="count" id="count"></span>
  </div>

  <div class="tablewrap">
    <table id="tbl">
      <colgroup>
        <col class="c-rank"><col class="c-tick"><col class="c-name"><col class="c-sect">
        <col class="c-score"><col class="c-gap">{% if has_dcf %}<col class="c-dcf">{% endif %}<col class="c-trend">{% if has_moves %}<col class="c-move">{% endif %}
      </colgroup>
      <thead><tr>
        <th data-k="rank" class="num" title="Rank 1 scores best on the four measures at the weights below."><span class="hfull">Rank (1 = best)</span><span class="hshort">Rank</span><span class="ar">&#9650;</span></th>
        <th data-k="ticker" class="c-tick-cell">Ticker<span class="ar">&#9650;</span></th>
        <th data-k="name">Company<span class="ar">&#9650;</span></th>
        <th data-k="sector" class="c-sect-cell">Sector<span class="ar">&#9650;</span></th>
        <th data-k="strain" class="num"><span class="hfull">Shortfall</span><span class="hshort">Score</span><span class="ar">&#9650;</span></th>
        <th data-k="gap" class="num">Drift (pp)<span class="ar">&#9650;</span></th>
        {% if has_dcf %}<th data-k="dcf" class="c-dcf-cell">DCF<span class="ar">&#9650;</span></th>{% endif %}
        <th data-k="ret_1y" class="num c-trend-cell">Past Year<span class="ar">&#9650;</span></th>
        {% if has_moves %}<th data-k="move" class="num c-move-cell" title="Share price move since first scored here on {{ since }}, without dividends.">Move<span class="ar">&#9650;</span></th>{% endif %}
      </tr></thead>
      <tbody id="tb"></tbody>
    </table>
  </div>

  <p class="asat">As at: <span data-asof="{{ asof.shortfall or '' }}">Shortfall {{ asof.shortfall or 'not dated' }}</span>
    &middot; <span data-asof="{{ asof.drift or '' }}">Consensus Drift {{ asof.drift or 'not dated' }}{% if drift_stale %}, not ranked on{% endif %}</span>{% if has_dcf %}
    &middot; <span data-asof="{{ asof.dcf or '' }}">DCF Studio {{ asof.dcf or 'not dated' }}</span>{% endif %}</p>

</div>

<script id="rows" type="application/json">{{ rows_json }}</script>
<script>
(function () {
  var ROWS = JSON.parse(document.getElementById("rows").textContent);
  var HAS_DCF = {{ 'true' if has_dcf else 'false' }};
  var HAS_MOVES = {{ 'true' if has_moves else 'false' }}, SINCE = "{{ since }}", N_DAYS = {{ n_days }};
  var DATES = {{ dates_json }}, BACKFILLED_UNTIL = {{ ('"' + backfilled_until + '"') if backfilled_until else 'null' }};
  var N_DCF = {{ n_dcf }};
  /* Run in the READER's browser against their clock, because if Crosscheck's own
     daily build stops, every date it baked stops with it and nothing at build time
     can say so. */
  (function () {
    Array.prototype.forEach.call(document.querySelectorAll("[data-asof]"), function (el) {
      var t = Date.parse(el.getAttribute("data-asof") + "T00:00:00Z");
      if (t && (Date.now() - t) / 864e5 > {{ stale_days }} && !el.classList.contains("overdue")) {
        el.classList.add("overdue");
        el.appendChild(document.createTextNode(", overdue"));
      }
    });
  })();
  var CUT = {{ corners.cut }};
  var tb = document.getElementById("tb");
  var q = document.getElementById("q"), count = document.getElementById("count");
  var clear = document.getElementById("clear");
  var sortKey = "rank", sortDir = 1;

  var tip = document.getElementById("tip");
  var picked = null;

  // Sectors with fewer than ten names are folded into the chart's silence rather than
  // drawn: a strip of two dots is not a category, and a heatmap row off two companies
  // reports one company's accounts as a sector's habit.
  var MIN_SECTOR = 10;

  function fmtPct(v) { return Math.round(v * 100); }

  // The one company the charts single out: whatever the search box resolves to a
  // single row, or the dot clicked last. Nothing is marked when the search is empty -
  // a highlighted arbitrary company reads as a recommendation.
  function focus() {
    var v = visible();
    if (v.length === 1) return v[0];
    if (picked !== null && v.indexOf(ROWS[picked]) > -1) return ROWS[picked];
    return null;
  }

  // Where a score sits among the pool, 0 to 1. The ramp is centred on the pool's
  // median, not on 50: the geometric mean pulls scores down (median about 40), and
  // centred on 50 the histogram and the strip painted most of the page red.
  var POOL_SORTED = [];
  function scorePct(v) {
    var a = POOL_SORTED, lo = 0, hi = a.length;
    while (lo < hi) { var m = (lo + hi) >> 1; if (a[m] < v) lo = m + 1; else hi = m; }
    return a.length > 1 ? lo / (a.length - 1) : 0.5;
  }
  function pool() {
    // The set every chart draws: what the completeness toggle admits. NOT the search
    // result - a histogram of one bar says nothing - the search only marks a name.
    return ROWS.filter(function (r) { return !onlyAll.checked || r.complete; });
  }

  function dims(svg, hDesk, hPhone) {
    var w = Math.max(240, svg.clientWidth || svg.parentElement.clientWidth);
    var h = w < 420 ? hPhone : hDesk;
    svg.setAttribute("viewBox", "0 0 " + w + " " + h);
    svg.setAttribute("height", h);
    return { w: w, h: h };
  }

  function place(ev, wrap) {
    var box = tip.getBoundingClientRect();
    var left = ev.clientX - wrap.left + 14;
    if (left + box.width > wrap.width) left = ev.clientX - wrap.left - box.width - 14;
    tip.style.left = Math.max(0, left) + "px";
    tip.style.top = Math.max(0, ev.clientY - wrap.top - box.height - 10) + "px";
  }
  // Rebuilding the tip and reading its size on EVERY mousemove forced a layout of the
  // whole page, 600-row table included, which is what made the pointer feel slow
  // (07/10/2026). The content is only replaced when it changes, and moves are batched
  // to one per frame by throttled() below.
  var tipHtml = null;
  function showTip(html, ev) {
    if (html !== tipHtml) { tip.innerHTML = html; tipHtml = html; }
    tip.hidden = false;
    place(ev, chartsEl.getBoundingClientRect());
  }
  var chartsEl = document.querySelector(".charts");
  function throttled(fn) {
    var pending = null;
    return function (ev) {
      var first = pending === null;
      pending = ev;
      if (first) requestAnimationFrame(function () { var e = pending; pending = null; fn(e); });
    };
  }
  function hideTip() { tip.hidden = true; tipHtml = null; }

  // ---- 1. histogram of the combined score, one name marked ----
  function drawHist() {
    var svg = document.getElementById("hist");
    var d = dims(svg, 380, 230), M = { l: 56, r: 12, t: 12, b: 42 };
    var pw = d.w - M.l - M.r, ph = d.h - M.t - M.b;
    var rows = pool(), f = focus();
    POOL_SORTED = rows.map(function (r) { return r.score; }).sort(function (a, b) { return a - b; });
    var BINS = 25, counts = new Array(BINS).fill(0), members = [];
    for (var i = 0; i < BINS; i++) members.push([]);
    rows.forEach(function (r) {
      var k = Math.min(BINS - 1, Math.floor(r.score * 100 / (100 / BINS)));
      counts[k]++; members[k].push(r);
    });
    var top = Math.max.apply(null, counts) || 1;
    var X = function (v) { return M.l + (v / 100) * pw; };
    var Y = function (c) { return M.t + ph * (1 - c / top); };
    var parts = ['<rect class="ground" x="' + M.l + '" y="' + M.t + '" width="' + pw + '" height="' + ph + '"/>'];
    // Count gridlines at even divisions of the tallest bar, labelled on the left.
    var step = top > 40 ? 20 : top > 16 ? 10 : 5;
    for (var g = step; g <= top; g += step) {
      parts.push('<line class="guide" x1="' + M.l + '" x2="' + (M.l + pw) + '" y1="' + Y(g).toFixed(1) + '" y2="' + Y(g).toFixed(1) + '"/>');
      parts.push('<text class="tk" x="' + (M.l - 6) + '" y="' + (Y(g) + 4).toFixed(1) + '" text-anchor="end">' + g + "</text>");
    }
    [0, 25, 50, 75, 100].forEach(function (v) {
      parts.push('<text class="tk" x="' + X(v) + '" y="' + (M.t + ph + 16).toFixed(1) + '" text-anchor="middle">' + v + "</text>");
    });
    parts.push('<text class="ax" x="' + (M.l + pw / 2).toFixed(1) + '" y="' + (d.h - 2) + '" text-anchor="middle">Score</text>');
    // A y-axis title in its own column, rotated, rather than sharing the tick gutter.
    parts.push('<text class="ax" transform="rotate(-90)" x="' + (-(M.t + ph / 2)).toFixed(1) + '" y="12" text-anchor="middle">No. Companies</text>');
    var fk = f ? Math.min(BINS - 1, Math.floor(f.score * 100 / (100 / BINS))) : -1;
    for (i = 0; i < BINS; i++) {
      var x0 = X(i * (100 / BINS)), x1 = X((i + 1) * (100 / BINS));
      // The bar takes the same colour its score would get on the heatmap, so the three
      // charts share one meaning for amber and teal.
      parts.push('<rect class="bar-h' + (i === fk ? " hot" : "") + '" data-b="' + i + '" fill="' + markColour(scorePct((i + 0.5) / BINS)) +
                 '" x="' + (x0 + 0.5).toFixed(1) + '" y="' + Y(counts[i]).toFixed(1) +
                 '" width="' + Math.max(1, x1 - x0 - 1).toFixed(1) + '" height="' + (M.t + ph - Y(counts[i])).toFixed(1) + '"/>');
    }
    if (f) {
      var fx = X(f.score * 100);
      parts.push('<line class="mark" x1="' + fx + '" x2="' + fx + '" y1="' + M.t + '" y2="' + (M.t + ph) + '"/>');
      var anchor = f.score > 0.6 ? "end" : "start", dx = f.score > 0.6 ? -5 : 5;
      parts.push('<text class="mark-l" x="' + (fx + dx) + '" y="' + (M.t + 10) + '" text-anchor="' + anchor + '">' +
                 f.ticker + " " + Math.round(f.score * 100) + "</text>");
    }
    svg.innerHTML = parts.join("");
    svg.onmousemove = throttled(function (ev) {
      var t = ev.target;
      if (!t.classList || !t.classList.contains("bar-h")) { hideTip(); return; }
      var k = +t.dataset.b, lo = Math.round(k * 100 / BINS), hi = Math.round((k + 1) * 100 / BINS);
      var m = members[k].slice().sort(function (a, b) { return b.score - a.score; });
      showTip("<b>" + counts[k] + "</b> companies score " + lo + " to " + hi +
              (m.length ? '<span class="tl">' + m.slice(0, 6).map(function (r) { return r.ticker; }).join(", ") +
              (m.length > 6 ? " +" + (m.length - 6) : "") + "</span>" : ""), ev);
    });
    svg.onmouseleave = hideTip;
  }

  // ---- sectors, shared by the strip and the heatmap so their rows line up ----
  function sectorRows() {
    var by = {};
    pool().forEach(function (r) { (by[r.sector] = by[r.sector] || []).push(r); });
    var out = Object.keys(by).filter(function (k) { return by[k].length >= MIN_SECTOR; })
      .map(function (k) {
        var v = by[k].map(function (r) { return r.score; }).sort(function (a, b) { return a - b; });
        return { sector: k, rows: by[k], median: v[Math.floor(v.length / 2)] };
      });
    out.sort(function (a, b) { return b.median - a.median; });
    return out;
  }

  // ---- 8. score by sector, strip with the median marked ----
  function drawSectors() {
    var svg = document.getElementById("sect");
    var S = sectorRows(), f = focus();
    POOL_SORTED = pool().map(function (r) { return r.score; }).sort(function (a, b) { return a - b; });
    var rowH = 38, M = { l: 150, r: 12, t: 8, b: 42 };
    var d = dims(svg, M.t + S.length * rowH + M.b, M.t + S.length * rowH + M.b);
    if (d.w < 520) { rowH = 30; M.l = 120; d = dims(svg, M.t + S.length * rowH + M.b, M.t + S.length * rowH + M.b); }
    var pw = d.w - M.l - M.r;
    var X = function (v) { return M.l + v * pw; };
    var parts = ['<rect class="ground" x="' + M.l + '" y="' + M.t + '" width="' + pw + '" height="' + (S.length * rowH) + '"/>'];
    [0, 25, 50, 75, 100].forEach(function (v) {
      parts.push('<line class="guide" x1="' + X(v / 100) + '" x2="' + X(v / 100) + '" y1="' + M.t + '" y2="' + (M.t + S.length * rowH) + '"/>');
      parts.push('<text class="tk" x="' + X(v / 100) + '" y="' + (M.t + S.length * rowH + 16) + '" text-anchor="middle">' + v + "</text>");
    });
    parts.push('<text class="ax" x="' + (M.l + pw / 2).toFixed(1) + '" y="' + (d.h - 2) + '" text-anchor="middle">Score</text>');
    S.forEach(function (sec, i) {
      var cy = M.t + i * rowH + rowH / 2;
      if (i > 0) parts.push('<line class="rowrule" x1="' + M.l + '" x2="' + (d.w - M.r) + '" y1="' + (cy - rowH / 2) + '" y2="' + (cy - rowH / 2) + '"/>');
      // The count comes off under 520px: "Transport & comms 24" clipped at the left
      // edge at 390, and the hover carries n anyway.
      parts.push('<text class="slab" x="' + (M.l - 10) + '" y="' + (cy + 4) + '" text-anchor="end">' +
                 sec.sector + (d.w < 520 ? "" : ' <tspan class="n">' + sec.rows.length + "</tspan>") + "</text>");
      sec.rows.forEach(function (r, j) {
        // Deterministic jitter from the row's index, so a redraw does not shuffle the
        // dots and a hovered dot stays under the pointer.
        // +-8 in a 30px row leaves a 14px gutter, so one sector's dots never read as
        // its neighbour's. At +-10 the bands merged into one cloud.
        // ON the line, no vertical jitter: the vertical axis is the sector, so a dot
        // drawn higher or lower implies a second variable that does not exist. Charlie
        // asked why the dots moved vertically (07/10/2026); overlap now shows as density,
        // through the dots' own transparency.
        var jit = 0;
        var rad = r === f ? 5 : 3, cx = Math.max(M.l + rad, Math.min(M.l + pw - rad, X(r.score)));
        parts.push('<circle class="sdot' + (r === f ? " hot" : "") + '" data-i="' + ROWS.indexOf(r) + '" fill="' + markColour(scorePct(r.score)) +
                   '" cx="' + cx.toFixed(1) + '" cy="' + (cy + jit).toFixed(1) + '" r="' + rad + '"/>');
      });
      parts.push('<line class="smed" x1="' + X(sec.median) + '" x2="' + X(sec.median) + '" y1="' + (cy - rowH * 0.42) + '" y2="' + (cy + rowH * 0.42) + '"/>');
    });
    svg.innerHTML = parts.join("");
    svg.onmousemove = throttled(function (ev) {
      var t = ev.target;
      if (!t.classList || !t.classList.contains("sdot")) { hideTip(); return; }
      var r = ROWS[+t.dataset.i];
      showTip("<b>" + r.ticker + "</b> " + r.name + '<span class="tl">score <b>' + Math.round(r.score * 100) +
              "</b>, rank " + r.rank + " of " + pool().length + "</span>", ev);
    });
    svg.onmouseleave = hideTip;
    svg.onclick = function (ev) {
      var t = ev.target;
      if (!t.classList || !t.classList.contains("sdot")) return;
      picked = +t.dataset.i; q.value = ROWS[picked].ticker; render(); plot();
    };
  }

  // ---- 9. sector x component, median percentile ----
  // Diverging around 50, the median percentile: green above, red below. A sector at 82 on value and 37 on price-behind is the
  // finding this chart exists for - each sector is dragged by a DIFFERENT measure, and
  // no correlation anywhere on the page could have said that.
  // Green above 50, red below, and QUIET in the middle: chosen 20/09/2026 from ten
  // renderings ("Quiet middle: colour only where a sector departs from 50"). The
  // previous ramp gave every middling cell a grey-mauve fill that carried no meaning
  // and let nine solid blocks per column shout as loudly as the four that mattered.
  // Two mids: a cell sits on the page and fades to the tinted ground, a mark (a dot,
  // a bar) sits ON that ground and needs a slate it cannot vanish into. Both follow
  // the theme, so the toggle redraws.
  function isLight() { return document.documentElement.getAttribute("data-theme") === "light"; }
  function ramp(v, mid) {
    var t = Math.max(-1, Math.min(1, (v - 0.5) / 0.35));
    var green = isLight() ? [72, 146, 100] : [92, 166, 118];
    var red = isLight() ? [186, 82, 74] : [201, 96, 88];
    var a = t >= 0 ? green : red; t = Math.abs(t);
    var c = [0, 1, 2].map(function (i) { return mid[i] + (a[i] - mid[i]) * t; });
    return "rgb(" + c.map(Math.round).join(",") + ")";
  }
  function heatColour(v) { return ramp(v, isLight() ? [231, 234, 239] : [20, 26, 34]); }
  function markColour(v) { return ramp(v, isLight() ? [178, 186, 198] : [62, 71, 86]); }
  // How far a value sits from the middle, 0 at 50 and 1 at the ends of the ramp.
  function heatDepth(v) { return Math.min(1, Math.abs(v - 0.5) / 0.35); }
  function drawHeat() {
    var svg = document.getElementById("heat");
    // Built here too: the heatmap is the default chart and colours its Total column off
    // this list, so it cannot wait for another chart to have drawn first.
    POOL_SORTED = pool().map(function (r) { return r.score; }).sort(function (a, b) { return a - b; });
    var S = sectorRows();
    var rowH = 38, M = { l: 150, r: 4, t: 26, b: 6 };
    var d = dims(svg, M.t + S.length * rowH + M.b, M.t + S.length * rowH + M.b);
    if (d.w < 520) { rowH = 30; M.l = 120; d = dims(svg, M.t + S.length * rowH + M.b, M.t + S.length * rowH + M.b); }
    // Full wording where a column has room for it, matching the weight sliders; the
    // short form under 520px, where the three long heads overprinted - measured, two
    // of three collided at 390.
    // The middle column is the drift LEG the rank uses (estimates rising AND price
    // behind), not the gap alone, so the chart and the sliders describe one thing.
    // Total is the median of the score at the current weights, so it moves with the sliders.
    var COLS = d.w < 520
      ? [["pStrain", "Accounts"], ["leg", "Revisions"], ["pDcf", "Value"], ["pMom", "Momentum"], ["score", "Total"]]
      : [["pStrain", "Accounting Quality"], ["leg", "Estimate Revisions"], ["pDcf", "Valuation"], ["pMom", "Price Momentum"], ["score", "Total"]];
    var cw = (d.w - M.l - M.r) / COLS.length;
    var parts = [];
    COLS.forEach(function (c, j) {
      parts.push('<text class="ax" x="' + (M.l + cw * j + cw / 2) + '" y="' + (M.t - 9) + '" text-anchor="middle">' + c[1] + "</text>");
    });
    S.forEach(function (sec, i) {
      var y = M.t + i * rowH;
      parts.push('<text class="slab" x="' + (M.l - 10) + '" y="' + (y + rowH / 2 + 4) + '" text-anchor="end">' + sec.sector + "</text>");
      COLS.forEach(function (c, j) {
        var v = sec.rows.map(function (r) { return c[0] === "leg" ? driftLeg(r) : r[c[0]]; }).filter(function (x) { return x !== null; }).sort(function (a, b) { return a - b; });
        var med = v.length ? v[Math.floor(v.length / 2)] : null;
        var x = M.l + cw * j;
        // Total is a raw score whose median sits near 40, not a 0-100 rank, so it is
        // coloured by where that median falls among all companies (scorePct), like the
        // rest of the page's score colours; coloured as a rank every sector read low.
        var tone = med === null ? null : (c[0] === "score" ? scorePct(med) : med);
        parts.push('<rect class="hcell" rx="3" data-s="' + i + '" data-c="' + j + '" x="' + x + '" y="' + y + '" width="' + cw + '" height="' + rowH +
                   '" fill="' + (med === null ? "var(--rule)" : heatColour(tone)) + '"/>');
        // A middling figure is set soft, a strong one in ink and bold: the four numbers
        // that matter are the ones that read first.
        if (med !== null) parts.push('<text class="hval' + (heatDepth(tone) > 0.5 ? " strong" : "") + '" x="' + (x + cw / 2) + '" y="' + (y + rowH / 2 + 4) +
                   '">' + fmtPct(med) + "</text>");
      });
    });
    svg.innerHTML = parts.join("");
    // Centred under the grid, not under the figure: the grid starts after the sector labels.
    document.getElementById("heatkey").style.paddingLeft = M.l + "px";
    document.getElementById("heatkey").innerHTML =
      '<span class="ki"><i class="sw" style="background:' + heatColour(0.85) + '"></i>High</span>' +
      '<span class="ki"><i class="sw" style="background:' + heatColour(0.5) + ';border:1px solid var(--rule)"></i>Middle</span>' +
      '<span class="ki"><i class="sw" style="background:' + heatColour(0.15) + '"></i>Low</span>';
    svg.onmousemove = throttled(function (ev) {
      var t = ev.target;
      if (!t.classList || !t.classList.contains("hcell")) { hideTip(); return; }
      var sec = S[+t.dataset.s], c = COLS[+t.dataset.c];
      var v = sec.rows.map(function (r) { return c[0] === "leg" ? driftLeg(r) : r[c[0]]; }).filter(function (x) { return x !== null; }).sort(function (a, b) { return a - b; });
      showTip("<b>" + sec.sector + "</b> on " + c[1].toLowerCase() +
              '<span class="tl">median percentile <b>' + (v.length ? fmtPct(v[Math.floor(v.length / 2)]) : "-") +
              "</b> across " + v.length + " companies</span>", ev);
    });
    svg.onmouseleave = hideTip;
  }

  // ---- 4. move since first scored, by quintile of the score on that day ----
  // The forward test: the score as it stood on the first day a company was recorded,
  // against what its price did afterwards. Scored with the CURRENT weights from the
  // day-one components, so the sliders move this chart too. The axis carries the
  // window, because a fortnight is not a result and a quarter might be; the chart is
  // here from day eight so the reader watches it become one rather than being handed
  // a verdict. Spearman rho and n are printed for the same reason.
  function score0(r) {
    if (!r.h0) return null;
    return r.h0[5] ? scoreOf({ pStrain: r.h0[6], pDrift: r.h0[1], pRev: r.h0[2], pMom: r.h0[4] })
                   : scoreOf({ pStrain: r.h0[0], pDrift: r.h0[1], pRev: r.h0[2], pDcf: r.h0[3], pMom: r.h0[4] });
  }
  function spearman(pairs) {
    function ranks(a) {
      var idx = a.map(function (v, i) { return [v, i]; }).sort(function (p, q) { return p[0] - q[0]; });
      var out = new Array(a.length), i = 0;
      while (i < idx.length) {
        var j = i; while (j + 1 < idx.length && idx[j + 1][0] === idx[i][0]) j++;
        for (var k = i; k <= j; k++) out[idx[k][1]] = (i + j) / 2;
        i = j + 1;
      }
      return out;
    }
    var n = pairs.length; if (n < 3) return null;
    var ra = ranks(pairs.map(function (p) { return p[0]; })), rb = ranks(pairs.map(function (p) { return p[1]; }));
    var ma = ra.reduce(function (s, v) { return s + v; }, 0) / n, mb = rb.reduce(function (s, v) { return s + v; }, 0) / n;
    var num = 0, da = 0, db = 0;
    for (var i = 0; i < n; i++) { num += (ra[i] - ma) * (rb[i] - mb); da += (ra[i] - ma) * (ra[i] - ma); db += (rb[i] - mb) * (rb[i] - mb); }
    return da && db ? num / Math.sqrt(da * db) : null;
  }
  function fmtDate(d) {
    var p = d.split("-"), M = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    return (+p[2]) + " " + M[+p[1] - 1];
  }
  var FIFTH = ["Bottom quintile", "Second", "Middle", "Fourth", "Top quintile"];
  function fifthColour(q) { return markColour([0.05, 0.3, 0.5, 0.7, 0.95][q]); }
  function scoreAt(ev) {   // the combined score from one event's components, at the current weights
    // A reconstructed day (ev[6]) is scored on its point-in-time legs only: estimate
    // revisions, price momentum (prices up to that date) and, for US names, Accounting
    // Quality rebuilt from the SEC filings public by then (ev[9], strain_history.py) -
    // never the hindsight strain or DCF figures the line also carries.
    return ev[6] ? scoreOf({ pStrain: ev[9], pDrift: ev[2], pRev: ev[3], pMom: ev[5] })
                 : scoreOf({ pStrain: ev[1], pDrift: ev[2], pRev: ev[3], pDcf: ev[4], pMom: ev[5] });
  }
  // An event's price path does not depend on the weights, so it is built once per
  // (company, scoring date) and its value at each horizon is memoised. The chart used to
  // rebuild every path and search it at every horizon on every draw, about five million
  // steps, which was most of the 400ms a switch to this chart took on a slower CPU.
  var DAY = 86400000, T = DATES.map(function (x) { return Date.parse(x); }), OBS = {};
  function obsFor(r, j) {
    var key = r.ticker + "|" + j;
    if (key in OBS) return OBS[key];
    var out = null;
    if (r.mvs && r.mvs[j] !== null) {
      var base = 1 + r.mvs[j] / 100, obs = [];
      for (var k = j + 1; k < r.mvs.length; k++)
        if (r.mvs[k] !== null) obs.push([(T[k] - T[j]) / DAY, ((1 + r.mvs[k] / 100) / base - 1) * 100]);
      if (obs.length) out = { obs: obs, last: obs[obs.length - 1], hk: null, vals: null };
    }
    return (OBS[key] = out);
