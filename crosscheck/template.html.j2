<body>
<div class="wrap">
  <div class="bar">
    <nav class="nav">
      <!-- The three sites this page is built from. They each carry a Crosscheck link in
           their own nav, so this is the return leg - without it the estate links one
           way only. No arrows: those mean up a level and these go sideways. -->
      <a class="home sib" href="https://charlietrenorden.com/shortfall/">Shortfall</a>
      <a class="home sib" href="https://charlietrenorden.com/consensus-drift/">Consensus Drift</a>
      <a class="home sib" href="https://dcf.charlietrenorden.com/">DCF Studio</a>
      <a class="home" href="https://charlietrenorden.com/"><span class="back">&larr;</span>Other projects</a>
    </nav>
    <button class="toggle" id="themeBtn" type="button" aria-label="Toggle light and dark theme"><span class="dot"></span><span id="themeLbl">Dark</span></button>
  </div>

  <h1>Crosscheck</h1>
  <p class="lede">{{ n }} companies ranked on accounting strain, estimate drift and model value, at weights you set.</p>

  <!-- Three charts, chosen from thirteen rendered on the live rows. All three are
       aria-hidden and the table below carries every value they draw: they are
       readings of the table, not the data. -->
  <!-- One chart at a time. Three side by side at 340px each was the case the site
       style already names - several small charts become unreadable - and its answer is
       a way to flick between larger ones. The segmented control IS the chart title, so
       the figures carry none of their own. All three are aria-hidden; the table below
       holds every value they draw. -->
  <div class="segmented" id="chartpick" role="group" aria-label="Choose a chart">
    <button type="button" data-chart="heat" aria-pressed="true">Sector Medians by Measure</button>
    <button type="button" data-chart="sect" aria-pressed="false">Combined Score by Sector</button>
    <button type="button" data-chart="hist" aria-pressed="false">Combined Score Distribution</button>
  </div>
  <div class="charts">
    <figure class="ch" id="fig-heat">
      <svg id="heat" aria-hidden="true"></svg>
      <div class="key" id="heatkey"></div>
    </figure>
    <figure class="ch" id="fig-sect" hidden>
      <svg id="sect" aria-hidden="true"></svg>
    </figure>
    <figure class="ch" id="fig-hist" hidden>
      <svg id="hist" aria-hidden="true"></svg>
    </figure>
    <div class="tip" id="tip" hidden></div>
  </div>

  <div class="weights">
    <!-- Each label says what MORE WEIGHT FAVOURS, not which column it comes from.
         Labelled "Shortfall", turning the slider to 100% surfaces the companies scoring
         ZERO on Shortfall - correct, because a high score is worse and the measure is
         inverted before it is weighted, but it reads as a bug. A weight control has one
         job: to say which way it pulls. -->
    <span class="wl">Rank favours</span>
    <label class="w"><span>Clean accounts</span>
      <input type="range" id="wStrain" min="0" max="100" step="5" value="35">
      <b id="wStrainV">33%</b></label>
    <label class="w"><span>Price behind estimates</span>
      <input type="range" id="wDrift" min="0" max="100" step="5" value="35">
      <b id="wDriftV">33%</b></label>
    <label class="w"><span>Value above price</span>
      <input type="range" id="wDcf" min="0" max="100" step="5" value="35">
      <b id="wDcfV">33%</b></label>
    <button class="clear" id="wReset" type="button">Even</button>
  </div>

  <div class="allbar">
    <label class="chk"><input type="checkbox" id="onlyAll" checked>
      Only names scored by all three</label>
    <button class="clear" id="clear" type="button" hidden>Clear</button>
    <span class="count" id="count"></span>
  </div>

  <div class="toolbar">
    <input class="search" id="q" type="search" placeholder="Ticker or company" aria-label="Find a company">
  </div>

  <div class="tablewrap">
    <table id="tbl">
      <colgroup>
        <col class="c-rank"><col class="c-tick"><col class="c-name"><col class="c-sect">
        <col class="c-score"><col class="c-gap">{% if has_dcf %}<col class="c-dcf">{% endif %}
      </colgroup>
      <thead><tr>
        <th data-k="rank" class="num" title="Position among the companies on this page, combining all three measures at the weights set below. Rank 1 has the cleanest accounts, the price furthest behind estimates and the highest model value against price.">Rank<span class="ar">&#9650;</span></th>
        <th data-k="ticker" class="c-tick-cell">Ticker<span class="ar">&#9650;</span></th>
        <th data-k="name">Company<span class="ar">&#9650;</span></th>
        <th data-k="sector" class="c-sect-cell">Sector<span class="ar">&#9650;</span></th>
        <th data-k="strain" class="num"><span class="hfull">Shortfall</span><span class="hshort">Score</span><span class="ar">&#9650;</span></th>
        <th data-k="gap" class="num">Drift (pp)<span class="ar">&#9650;</span></th>
        {% if has_dcf %}<th data-k="dcf" class="c-dcf-cell">DCF<span class="ar">&#9650;</span></th>{% endif %}
      </tr></thead>
      <tbody id="tb"></tbody>
    </table>
  </div>

  <h2>Notes</h2>
  <p class="foot">
    <!-- Cut from eight sentences to three on 10/09/2026: "way too long". What went was
         everything explaining a column that its own header and values already say -
         what Tests counted, what the DCF bands mean, why the two measures are
         independent. What stays is the three things a reader cannot deduce from the
         page: which way each scale runs, and that Rank is a combination. -->
    Shortfall runs 0 to 100, higher is more strained. A positive drift means the price
    sits behind analyst estimates. Rank combines all three and puts clean accounts,
    a price behind estimates and a model value above the price at the top. General
    information, not advice.
  </p>
</div>

<script id="rows" type="application/json">{{ rows_json }}</script>
<script>
(function () {
  var ROWS = JSON.parse(document.getElementById("rows").textContent);
  var HAS_DCF = {{ 'true' if has_dcf else 'false' }};
  var N_DCF = {{ n_dcf }};
  var CUT = {{ corners.cut }};
  var tb = document.getElementById("tb");
  var q = document.getElementById("q"), count = document.getElementById("count");
  var clear = document.getElementById("clear");
  var sortKey = "rank", sortDir = 1;

  var tip = document.getElementById("tip");
  var picked = null;

  // Sectors with fewer than ten names are folded into the chart's silence rather than
  // drawn: a strip of two dots is not a category, and a heatmap row off two companies
  // reports one company's accounts as a sector's habit.
  var MIN_SECTOR = 10;

  function fmtPct(v) { return Math.round(v * 100); }

  // The one company the charts single out: whatever the search box resolves to a
  // single row, or the dot clicked last. Nothing is marked when the search is empty -
  // a highlighted arbitrary company reads as a recommendation.
  function focus() {
    var v = visible();
    if (v.length === 1) return v[0];
    if (picked !== null && v.indexOf(ROWS[picked]) > -1) return ROWS[picked];
    return null;
  }

  function pool() {
    // The set every chart draws: what the completeness toggle admits. NOT the search
    // result - a histogram of one bar says nothing - the search only marks a name.
    return ROWS.filter(function (r) { return !onlyAll.checked || r.complete; });
  }

  function dims(svg, hDesk, hPhone) {
    var w = Math.max(240, svg.clientWidth || svg.parentElement.clientWidth);
    var h = w < 420 ? hPhone : hDesk;
    svg.setAttribute("viewBox", "0 0 " + w + " " + h);
    svg.setAttribute("height", h);
    return { w: w, h: h };
  }

  function place(ev, wrap) {
    var box = tip.getBoundingClientRect();
    var left = ev.clientX - wrap.left + 14;
    if (left + box.width > wrap.width) left = ev.clientX - wrap.left - box.width - 14;
    tip.style.left = Math.max(0, left) + "px";
    tip.style.top = Math.max(0, ev.clientY - wrap.top - box.height - 10) + "px";
  }
  function showTip(html, ev) {
    tip.innerHTML = html; tip.hidden = false;
    place(ev, document.querySelector(".charts").getBoundingClientRect());
  }
  function hideTip() { tip.hidden = true; }

  // ---- 1. histogram of the combined score, one name marked ----
  function drawHist() {
    var svg = document.getElementById("hist");
    var d = dims(svg, 380, 230), M = { l: 36, r: 12, t: 22, b: 32 };
    var pw = d.w - M.l - M.r, ph = d.h - M.t - M.b;
    var rows = pool(), f = focus();
    var BINS = 25, counts = new Array(BINS).fill(0), members = [];
    for (var i = 0; i < BINS; i++) members.push([]);
    rows.forEach(function (r) {
      var k = Math.min(BINS - 1, Math.floor(r.score * 100 / (100 / BINS)));
      counts[k]++; members[k].push(r);
    });
    var top = Math.max.apply(null, counts) || 1;
    var X = function (v) { return M.l + (v / 100) * pw; };
    var Y = function (c) { return M.t + ph * (1 - c / top); };
    var parts = ['<rect class="ground" x="' + M.l + '" y="' + M.t + '" width="' + pw + '" height="' + ph + '"/>'];
    // Count gridlines at even divisions of the tallest bar, labelled on the left.
    var step = top > 40 ? 20 : top > 16 ? 10 : 5;
    for (var g = step; g <= top; g += step) {
      parts.push('<line class="guide" x1="' + M.l + '" x2="' + (M.l + pw) + '" y1="' + Y(g).toFixed(1) + '" y2="' + Y(g).toFixed(1) + '"/>');
      parts.push('<text class="tk" x="' + (M.l - 6) + '" y="' + (Y(g) + 4).toFixed(1) + '" text-anchor="end">' + g + "</text>");
    }
    [0, 25, 50, 75, 100].forEach(function (v) {
      parts.push('<text class="tk" x="' + X(v) + '" y="' + (d.h - 14) + '" text-anchor="middle">' + v + "</text>");
    });
    parts.push('<text class="ax" x="' + M.l + '" y="' + (d.h - 2) + '">Combined score</text>');
    parts.push('<text class="ax" x="' + M.l + '" y="' + (M.t - 6) + '">Companies</text>');
    var fk = f ? Math.min(BINS - 1, Math.floor(f.score * 100 / (100 / BINS))) : -1;
    for (i = 0; i < BINS; i++) {
      var x0 = X(i * (100 / BINS)), x1 = X((i + 1) * (100 / BINS));
      // The bar takes the same colour its score would get on the heatmap, so the three
      // charts share one meaning for amber and teal.
      parts.push('<rect class="bar-h' + (i === fk ? " hot" : "") + '" data-b="' + i + '" fill="' + heatColour((i + 0.5) / BINS) +
                 '" x="' + (x0 + 0.5).toFixed(1) + '" y="' + Y(counts[i]).toFixed(1) +
                 '" width="' + Math.max(1, x1 - x0 - 1).toFixed(1) + '" height="' + (M.t + ph - Y(counts[i])).toFixed(1) + '"/>');
    }
    if (f) {
      var fx = X(f.score * 100);
      parts.push('<line class="mark" x1="' + fx + '" x2="' + fx + '" y1="' + M.t + '" y2="' + (M.t + ph) + '"/>');
      var anchor = f.score > 0.6 ? "end" : "start", dx = f.score > 0.6 ? -5 : 5;
      parts.push('<text class="mark-l" x="' + (fx + dx) + '" y="' + (M.t + 10) + '" text-anchor="' + anchor + '">' +
                 f.ticker + " " + Math.round(f.score * 100) + "</text>");
    }
    svg.innerHTML = parts.join("");
    svg.onmousemove = function (ev) {
      var t = ev.target;
      if (!t.classList || !t.classList.contains("bar-h")) { hideTip(); return; }
      var k = +t.dataset.b, lo = Math.round(k * 100 / BINS), hi = Math.round((k + 1) * 100 / BINS);
      var m = members[k].slice().sort(function (a, b) { return b.score - a.score; });
      showTip("<b>" + counts[k] + "</b> companies score " + lo + " to " + hi +
              (m.length ? '<span class="tl">' + m.slice(0, 6).map(function (r) { return r.ticker; }).join(", ") +
              (m.length > 6 ? " +" + (m.length - 6) : "") + "</span>" : ""), ev);
    };
    svg.onmouseleave = hideTip;
  }

  // ---- sectors, shared by the strip and the heatmap so their rows line up ----
  function sectorRows() {
    var by = {};
    pool().forEach(function (r) { (by[r.sector] = by[r.sector] || []).push(r); });
    var out = Object.keys(by).filter(function (k) { return by[k].length >= MIN_SECTOR; })
      .map(function (k) {
        var v = by[k].map(function (r) { return r.score; }).sort(function (a, b) { return a - b; });
        return { sector: k, rows: by[k], median: v[Math.floor(v.length / 2)] };
      });
    out.sort(function (a, b) { return b.median - a.median; });
    return out;
  }

  // ---- 8. score by sector, strip with the median marked ----
  function drawSectors() {
    var svg = document.getElementById("sect");
    var S = sectorRows(), f = focus();
    var rowH = 38, M = { l: 150, r: 12, t: 8, b: 32 };
    var d = dims(svg, M.t + S.length * rowH + M.b, M.t + S.length * rowH + M.b);
    if (d.w < 520) { rowH = 30; M.l = 120; d = dims(svg, M.t + S.length * rowH + M.b, M.t + S.length * rowH + M.b); }
    var pw = d.w - M.l - M.r;
    var X = function (v) { return M.l + v * pw; };
    var parts = ['<rect class="ground" x="' + M.l + '" y="' + M.t + '" width="' + pw + '" height="' + (S.length * rowH) + '"/>'];
    [0, 25, 50, 75, 100].forEach(function (v) {
      parts.push('<line class="guide" x1="' + X(v / 100) + '" x2="' + X(v / 100) + '" y1="' + M.t + '" y2="' + (M.t + S.length * rowH) + '"/>');
      parts.push('<text class="tk" x="' + X(v / 100) + '" y="' + (d.h - 14) + '" text-anchor="middle">' + v + "</text>");
    });
    parts.push('<text class="ax" x="' + M.l + '" y="' + (d.h - 2) + '">Combined score, median marked</text>');
    S.forEach(function (sec, i) {
      var cy = M.t + i * rowH + rowH / 2;
      if (i > 0) parts.push('<line class="rowrule" x1="' + M.l + '" x2="' + (d.w - M.r) + '" y1="' + (cy - rowH / 2) + '" y2="' + (cy - rowH / 2) + '"/>');
      // The count comes off under 520px: "Transport & comms 24" clipped at the left
      // edge at 390, and the hover carries n anyway.
      parts.push('<text class="slab" x="' + (M.l - 10) + '" y="' + (cy + 4) + '" text-anchor="end">' +
                 sec.sector + (d.w < 520 ? "" : ' <tspan class="n">' + sec.rows.length + "</tspan>") + "</text>");
      sec.rows.forEach(function (r, j) {
        // Deterministic jitter from the row's index, so a redraw does not shuffle the
        // dots and a hovered dot stays under the pointer.
        // +-8 in a 30px row leaves a 14px gutter, so one sector's dots never read as
        // its neighbour's. At +-10 the bands merged into one cloud.
        var amp = rowH * 0.3;
        var jit = ((Math.sin(j * 12.9898 + i * 78.233) * 43758.5453) % 1) * amp * 2 - amp;
        parts.push('<circle class="sdot' + (r === f ? " hot" : "") + '" data-i="' + ROWS.indexOf(r) + '" fill="' + heatColour(r.score) +
                   '" cx="' + X(r.score).toFixed(1) + '" cy="' + (cy + jit).toFixed(1) + '" r="' + (r === f ? 5 : 3) + '"/>');
      });
      parts.push('<line class="smed" x1="' + X(sec.median) + '" x2="' + X(sec.median) + '" y1="' + (cy - rowH * 0.42) + '" y2="' + (cy + rowH * 0.42) + '"/>');
    });
    svg.innerHTML = parts.join("");
    svg.onmousemove = function (ev) {
      var t = ev.target;
      if (!t.classList || !t.classList.contains("sdot")) { hideTip(); return; }
      var r = ROWS[+t.dataset.i];
      showTip("<b>" + r.ticker + "</b> " + r.name + '<span class="tl">score <b>' + Math.round(r.score * 100) +
              "</b>, rank " + r.rank + " of " + pool().length + "</span>", ev);
    };
    svg.onmouseleave = hideTip;
    svg.onclick = function (ev) {
      var t = ev.target;
      if (!t.classList || !t.classList.contains("sdot")) return;
      picked = +t.dataset.i; q.value = ROWS[picked].ticker; render(); plot();
    };
  }

  // ---- 9. sector x component, median percentile ----
  // Diverging around 50, the median percentile: teal above, amber below, the page's
  // own direction colours. A sector at 82 on value and 37 on price-behind is the
  // finding this chart exists for - each sector is dragged by a DIFFERENT measure, and
  // no correlation anywhere on the page could have said that.
  function heatColour(v) {
    var t = Math.max(-1, Math.min(1, (v - 0.5) / 0.35));
    var teal = [111, 159, 168], amber = [193, 154, 91], mid = [125, 135, 152];
    var c = t >= 0 ? [mid[0] + (teal[0] - mid[0]) * t, mid[1] + (teal[1] - mid[1]) * t, mid[2] + (teal[2] - mid[2]) * t]
                   : [mid[0] + (amber[0] - mid[0]) * -t, mid[1] + (amber[1] - mid[1]) * -t, mid[2] + (amber[2] - mid[2]) * -t];
    return "rgb(" + c.map(Math.round).join(",") + ")";
  }
  function drawHeat() {
    var svg = document.getElementById("heat");
    var S = sectorRows();
    var rowH = 38, M = { l: 150, r: 4, t: 26, b: 6 };
    var d = dims(svg, M.t + S.length * rowH + M.b, M.t + S.length * rowH + M.b);
    if (d.w < 520) { rowH = 30; M.l = 120; d = dims(svg, M.t + S.length * rowH + M.b, M.t + S.length * rowH + M.b); }
    // Full wording where a column has room for it, matching the weight sliders; the
    // short form under 520px, where the three long heads overprinted - measured, two
    // of three collided at 390.
    var COLS = d.w < 520
      ? [["pStrain", "Clean"], ["pDrift", "Behind"], ["pDcf", "Value"]]
      : [["pStrain", "Clean accounts"], ["pDrift", "Price behind"], ["pDcf", "Value above price"]];
    var cw = (d.w - M.l - M.r) / 3;
    var parts = [];
    COLS.forEach(function (c, j) {
      parts.push('<text class="ax" x="' + (M.l + cw * j + cw / 2) + '" y="' + (M.t - 9) + '" text-anchor="middle">' + c[1] + "</text>");
    });
    S.forEach(function (sec, i) {
      var y = M.t + i * rowH;
      parts.push('<text class="slab" x="' + (M.l - 10) + '" y="' + (y + rowH / 2 + 4) + '" text-anchor="end">' + sec.sector + "</text>");
      COLS.forEach(function (c, j) {
        var v = sec.rows.map(function (r) { return r[c[0]]; }).filter(function (x) { return x !== null; }).sort(function (a, b) { return a - b; });
        var med = v.length ? v[Math.floor(v.length / 2)] : null;
        var x = M.l + cw * j;
        parts.push('<rect class="hcell" rx="3" data-s="' + i + '" data-c="' + j + '" x="' + x + '" y="' + y + '" width="' + cw + '" height="' + rowH +
                   '" fill="' + (med === null ? "var(--rule)" : heatColour(med)) + '"/>');
        if (med !== null) parts.push('<text class="hval" x="' + (x + cw / 2) + '" y="' + (y + rowH / 2 + 4) +
                   '" fill="' + (Math.abs(med - 0.5) > 0.22 ? "#0f1319" : "#e6e9ee") + '">' + fmtPct(med) + "</text>");
      });
    });
    svg.innerHTML = parts.join("");
    document.getElementById("heatkey").innerHTML =
      '<span class="ki"><i class="sw" style="background:' + heatColour(0.85) + '"></i>Sector sits high on this measure</span>' +
      '<span class="ki"><i class="sw" style="background:' + heatColour(0.5) + '"></i>Middle</span>' +
      '<span class="ki"><i class="sw" style="background:' + heatColour(0.15) + '"></i>Sits low</span>';
    svg.onmousemove = function (ev) {
      var t = ev.target;
      if (!t.classList || !t.classList.contains("hcell")) { hideTip(); return; }
      var sec = S[+t.dataset.s], c = COLS[+t.dataset.c];
      var v = sec.rows.map(function (r) { return r[c[0]]; }).filter(function (x) { return x !== null; }).sort(function (a, b) { return a - b; });
      showTip("<b>" + sec.sector + "</b> on " + c[1].toLowerCase() +
              '<span class="tl">median percentile <b>' + (v.length ? fmtPct(v[Math.floor(v.length / 2)]) : "-") +
              "</b> across " + v.length + " companies</span>", ev);
    };
    svg.onmouseleave = hideTip;
  }

  function markPicked() {}   // the charts mark focus() on every redraw
  // Remembered per browser, never in the URL: a link should open on the page's own
  // default, not on whichever chart the sender happened to be looking at.
  var CHART = "heat";
  try { CHART = localStorage.getItem("crosscheck.chart") || "heat"; } catch (e) {}
  var DRAW = { heat: drawHeat, sect: drawSectors, hist: drawHist };
  if (!DRAW[CHART]) CHART = "heat";

  function showChart(k) {
    CHART = k;
    try { localStorage.setItem("crosscheck.chart", k); } catch (e) {}
    ["heat", "sect", "hist"].forEach(function (id) {
      document.getElementById("fig-" + id).hidden = id !== k;
    });
    document.querySelectorAll("#chartpick button").forEach(function (b) {
      b.setAttribute("aria-pressed", String(b.dataset.chart === k));
    });
    hideTip();
    plot();
  }
  document.querySelectorAll("#chartpick button").forEach(function (b) {
    b.addEventListener("click", function () { showChart(b.dataset.chart); });
  });

  // Only the visible chart is drawn. A hidden figure measures zero wide, and drawing
  // into it would size every label off nothing.
  function plot() { DRAW[CHART](); }

  var rz;
  window.addEventListener("resize", function () {
    clearTimeout(rz);
    rz = setTimeout(plot, 150);
  });

  var W = { strain: 33, drift: 33, dcf: 33 };
  var onlyAll = document.getElementById("onlyAll");

  // Rescore and re-rank the whole set. The three components arrive as percentiles from
  // the build, so this is arithmetic rather than a re-sort of the source data - a
  // slider move costs one pass over 609 rows.
  //
  // A component with no reading is left OUT of the weighted mean rather than scored
  // zero, and the remaining weights are renormalised over what is present. Scoring the
  // absence would rank a company by how much data exists about it: 53% of utilities
  // have no DCF reading, and they would all sink together for a reason that is about
  // the model rather than about them.
  function rescore() {
    ROWS.forEach(function (r) {
      var num = 0, den = 0;
      if (r.pStrain !== null) { num += W.strain * r.pStrain; den += W.strain; }
      if (r.pDrift !== null) { num += W.drift * r.pDrift; den += W.drift; }
      if (r.pDcf !== null) { num += W.dcf * r.pDcf; den += W.dcf; }
      r.score = den > 0 ? num / den : 0;
    });
    var pool = ROWS.filter(function (r) { return !onlyAll.checked || r.complete; });
    var ordered = pool.slice().sort(function (a, b) {
      return b.score - a.score || a.ticker.localeCompare(b.ticker);
    });
    ROWS.forEach(function (r) { r.rank = null; });
    ordered.forEach(function (r, i) { r.rank = i + 1; });
  }

  function readWeights() {
    var raw = {};
    ["strain", "drift", "dcf"].forEach(function (k) {
      var id = "w" + k.charAt(0).toUpperCase() + k.slice(1);
      raw[k] = +document.getElementById(id).value;
    });
    var total = raw.strain + raw.drift + raw.dcf;
    ["strain", "drift", "dcf"].forEach(function (k) {
      var id = "w" + k.charAt(0).toUpperCase() + k.slice(1);
      W[k] = raw[k];
      document.getElementById(id + "V").textContent =
        total > 0 ? Math.round((raw[k] / total) * 100) + "%" : "-";
    });
    rescore();
    render();
    plot();
  }
  ["wStrain", "wDrift", "wDcf"].forEach(function (id) {
    document.getElementById(id).addEventListener("input", readWeights);
  });
  document.getElementById("wReset").addEventListener("click", function () {
    ["wStrain", "wDrift", "wDcf"].forEach(function (id) {
      document.getElementById(id).value = 35;
    });
    readWeights();
  });
  onlyAll.addEventListener("change", function () { rescore(); render(); plot(); });

  function visible() {
    var term = q.value.trim().toLowerCase();
    return ROWS.filter(function (r) {
      if (onlyAll.checked && !r.complete) return false;
      if (!term) return true;
      // Match from the START of the ticker or of a word in the name. Substring
      // matching returns Camden Property Trust for "AMD"; this is the rule the
      // other two sites already use.
      if (r.ticker.toLowerCase().indexOf(term) === 0) return true;
      return r.name.toLowerCase().split(/[^a-z0-9]+/).some(function (w) {
        return w.indexOf(term) === 0;
      });
    });
  }

  // Charlie: the three measures should say more on hover. Each says what the figure
  // is MADE OF rather than restating it - what the score was computed over, the two
  // moves the drift is the difference between, and what the model actually concluded.
  function strainTip(r) {
    return "Ranked against " + r.sector + ", on " + r.applicable +
           " of Shortfall's 6 accounting tests. 100 is the most strained.";
  }
  function driftTip(r) {
    var a = r.rev === null || r.rev === undefined ? null : r.rev;
    var b = r.pxchg === null || r.pxchg === undefined ? null : r.pxchg;
    if (a === null || b === null) return "Estimates against price over 90 days.";
    var s = (a > 0 ? "+" : "") + a.toFixed(1) + "% vs the price " +
            (b > 0 ? "+" : "") + b.toFixed(1) + "% over 90 days";
    return "Consensus earnings estimates " + s + ", so the price is " +
           (r.gap > 0 ? "behind" : r.gap < 0 ? "ahead of" : "level with") + " the estimates.";
  }
  function dcfTip(r) {
    if (r.dcf === null) return "DCF Studio could not produce a usable value for this company.";
    return "DCF Studio's model values the shares at " + r.dcf.toFixed(2) +
           " times the market price, which is the " + r.dcfband +
           " third of the " + N_DCF + " it can value.";
  }

  function render() {
    var rows = visible().slice().sort(function (a, b) {
      var x = a[sortKey], y = b[sortKey];
      if (x === null || x === undefined) return 1;   // no value sorts LAST both ways
      if (y === null || y === undefined) return -1;
      if (typeof x === "string") return x.localeCompare(y) * sortDir;
      return (x - y) * sortDir;
    });
    count.textContent = rows.length === ROWS.length
      ? rows.length + " companies"
      : rows.length + " of " + ROWS.length;
    clear.hidden = !q.value && picked === null;

    if (!rows.length) { tb.innerHTML = '<tr><td class="empty" colspan="' + (HAS_DCF ? 7 : 6) + '">No companies match.</td></tr>'; return; }
    tb.innerHTML = rows.map(function (r) {
      var t = encodeURIComponent(r.ticker);
      return '<tr>' +
        '<td class="num rank">' + (r.rank === null ? "-" : r.rank) + "</td>" +
        '<td class="tick c-tick-cell">' + r.ticker + "</td>" +
        '<td><span class="tick-inline">' + r.ticker + '</span><span class="cname">' + r.name + "</span></td>" +
        '<td class="c-sect-cell">' + r.sector + "</td>" +
        // Tests is no longer a column of its own - it is a caveat on the score rather
        // than a measurement beside it, so it rides along as the cell's title.
        // Each figure opens the company on the site that measured it. A DCF of "-"
        // has no page behind it, so that one stays a plain dash.
        '<td class="num" title="' + strainTip(r) + '"><a class="src" href="https://charlietrenorden.com/shortfall/?q=' + t + '">' + r.strain.toFixed(0) + "</a></td>" +
        '<td class="num ' + r.reading + '" title="' + driftTip(r) + '"><a class="src" href="https://charlietrenorden.com/consensus-drift/?q=' + t + '">' +
          (r.gap > 0 ? "+" : "") + r.gap.toFixed(1) + "</a></td>" +
        (HAS_DCF ? '<td class="num c-dcf-cell dcf-' + r.dcfband + '" title="' + dcfTip(r) + '">' + (r.dcf === null
          ? '<span class="none">-</span>'
          : '<a class="src" href="https://dcf.charlietrenorden.com/' + t + '">' + r.dcf.toFixed(2) + "x</a>") + "</td>" : "") +
      "</tr>";
    }).join("");
  }

  document.querySelectorAll("thead th[data-k]").forEach(function (th) {
    th.addEventListener("click", function () {
      var k = th.dataset.k;
      // Arriving at a sort from elsewhere gives the direction someone asking for it
      // expects first; only a second click on the pressed column flips it.
      if (sortKey === k) { sortDir = -sortDir; }
      // Rank ascends first, because rank 1 is the top of the page and nobody clicking
      // "Rank" wants 609 first. The measures descend first; the text columns ascend.
      else { sortKey = k; sortDir = (k === "ticker" || k === "name" || k === "sector" || k === "rank") ? 1 : -1; }
      document.querySelectorAll("thead th[data-k]").forEach(function (o) {
        o.removeAttribute("aria-sort");
        o.querySelector(".ar").innerHTML = "&#9650;";
      });
      th.setAttribute("aria-sort", sortDir === 1 ? "ascending" : "descending");
      th.querySelector(".ar").innerHTML = sortDir === 1 ? "&#9650;" : "&#9660;";
      render();
    });
  });

  q.addEventListener("input", function () { render(); plot(); });
  clear.addEventListener("click", function () {
    q.value = ""; picked = null;
    render(); markPicked();
  });

  // A ?q= arriving from Shortfall or Consensus Drift lands on that company.
  var incoming = new URLSearchParams(location.search).get("q");
  if (incoming) q.value = incoming;

  showChart(CHART);
  readWeights();
  render();

  var btn = document.getElementById("themeBtn"), lbl = document.getElementById("themeLbl");
  function label() {
    lbl.textContent = document.documentElement.getAttribute("data-theme") === "dark" ? "Light" : "Dark";
  }
  label();
  btn.addEventListener("click", function () {
    var dark = document.documentElement.getAttribute("data-theme") === "dark";
    document.documentElement.setAttribute("data-theme", dark ? "light" : "dark");
    try { localStorage.setItem("theme", dark ? "light" : "dark"); } catch (e) {}
    label();
  });
})();
</script>
</body>
</html>
