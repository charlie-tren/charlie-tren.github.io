  // Every horizon in one walk of the path (both lists are in day order), cached against
  // the horizon list it was computed for.
  function valuesAt(o, H, TOL, hk) {
    if (o.hk === hk) return o.vals;
    var vals = new Array(H.length), i = 0, obs = o.obs;
    for (var k = 0; k < H.length; k++) {
      var h = H[k], tol = TOL[h], best = null, bestD = 1e9;
      while (i < obs.length && obs[i][0] < h - tol) i++;
      for (var m = i; m < obs.length && obs[m][0] <= h + tol; m++) {
        var dd = Math.abs(obs[m][0] - h); if (dd < bestD) { bestD = dd; best = obs[m][1]; }
