<script>
(function () {
  var ROWS = JSON.parse(document.getElementById("rows").textContent);
  var HAS_DCF = {{ 'true' if has_dcf else 'false' }};
  var N_DCF = {{ n_dcf }};
  var CUT = {{ corners.cut }};
  var tb = document.getElementById("tb");
  var q = document.getElementById("q"), count = document.getElementById("count");
  var clear = document.getElementById("clear");
  var sortKey = "rank", sortDir = 1;

  var svg = document.getElementById("plot"), tip = document.getElementById("tip");
  var picked = null;

  // The drift axis is CLAMPED rather than fitted. Measured over the 609: the values run
  // -211.1 to +56.7, but -60 to +60 already contains 606 of them, so fitting to the
  // data spends 70% of the plot on three distressed names and squashes everyone else
  // into a band. The three sit ON the edge as hollow marks with their true figure in
  // the readout, because a point silently parked off-canvas is worse than a squashed
  // axis - it reads as a company the page forgot.
  // Every axis the page can draw. The list is not "every field we happen to hold" - the
  // pairs were measured across all 609 first, and these are the ones where something
  // actually relates: market cap against short interest is rho -0.65, analyst count
  // against how many accounting tests can be run is +0.49, and one-year return against
  // the DCF ratio is -0.23. The page's own three measures are near-independent of each
  // other, which is exactly why they are worth reading together.
  var AXES = {
    strain:     { label: "Shortfall score",      get: function (r) { return r.strain; }, lo: 0, hi: 100 },
    gap:        { label: "Drift (pp)",           get: function (r) { return r.gap; }, clamp: 60 },
    dcf:        { label: "DCF, x market price",  get: function (r) { return r.dcf; }, clamp: 4 },
    ret_1y:     { label: "Return, 1 year",       get: function (r) { return r.ret_1y == null ? null : r.ret_1y * 100; }, clamp: 200 },
    short_int:  { label: "Short interest",       get: function (r) { return r.short_int == null ? null : r.short_int * 100; }, clamp: 25 },
    mcap:       { label: "Market cap (log)",     get: function (r) { return r.mcap ? Math.log10(r.mcap) : null; } },
    analysts:   { label: "Analysts covering",    get: function (r) { return r.analysts; } },
    applicable: { label: "Tests that ran",       get: function (r) { return r.applicable; }, lo: 0, hi: 6 },
    rev:        { label: "Estimate change, 90d", get: function (r) { return r.rev; }, clamp: 60 },
    pxchg:      { label: "Price change, 90d",    get: function (r) { return r.pxchg; }, clamp: 100 }
  };
  var xKey = "ret_1y", yKey = "dcf";

  function fillPickers() {
    ["yvar", "xvar"].forEach(function (id) {
      var sel = document.getElementById(id);
      sel.innerHTML = Object.keys(AXES).map(function (k) {
        return '<option value="' + k + '">' + AXES[k].label + "</option>";
      }).join("");
      sel.value = id === "yvar" ? yKey : xKey;
      sel.addEventListener("change", function () {
        if (id === "yvar") { yKey = sel.value; } else { xKey = sel.value; }
        plot();
      });
    });
  }

  // The dcfband value doubles as its CSS class, so this map is identity - it exists so
  // a band renamed in the build cannot silently paint every dot as "no reading".
  var BANDS = { cheaper: "cheaper", middle: "middle", dearer: "dearer" };

  function drawKey() {
    var items = [["cheaper", "Cheaper on the model"], ["middle", "Middle third"],
                 ["dearer", "Dearer on the model"], ["nodcf", "No model reading"]];
    document.getElementById("key").innerHTML = items.map(function (i) {
      return '<span class="ki"><i class="sw ' + i[0] + '"></i>' + i[1] + "</span>";
    }).join("");
  }

  function ranks(v) {
    var idx = v.map(function (x, i) { return i; }).sort(function (a, b) { return v[a] - v[b]; });
    var out = new Array(v.length), i = 0;
    while (i < idx.length) {
      var j = i;
      while (j + 1 < idx.length && v[idx[j + 1]] === v[idx[i]]) { j++; }
      for (var k = i; k <= j; k++) { out[idx[k]] = (i + j) / 2; }
      i = j + 1;
    }
    return out;
  }

  // Spearman, because every one of these is heavy-tailed and one distressed name should
  // not set the headline number.
  function rho(pairs) {
    var n = pairs.length;
    if (n < 30) { return null; }
    var ra = ranks(pairs.map(function (p) { return p[0]; }));
    var rb = ranks(pairs.map(function (p) { return p[1]; }));
    var ma = 0, mb = 0, i;
    for (i = 0; i < n; i++) { ma += ra[i]; mb += rb[i]; }
    ma /= n; mb /= n;
    var num = 0, da = 0, db = 0;
    for (i = 0; i < n; i++) {
      num += (ra[i] - ma) * (rb[i] - mb);
      da += (ra[i] - ma) * (ra[i] - ma);
      db += (rb[i] - mb) * (rb[i] - mb);
    }
    return (da && db) ? { r: num / Math.sqrt(da * db), n: n } : null;
  }

  function plot() {
    var ax = AXES[xKey], ay = AXES[yKey];
    var pts = [];
    visible().forEach(function (r) {
      var x = ax.get(r), y = ay.get(r);
      if (x == null || y == null || isNaN(x) || isNaN(y)) { return; }
      pts.push({ row: r, x: x, y: y });
    });

    var w = Math.max(280, svg.clientWidth || svg.parentElement.clientWidth);
    var h = w < 520 ? 300 : 430;
    var M = { l: 54, r: 12, t: 12, b: 42 };
    svg.setAttribute("viewBox", "0 0 " + w + " " + h);
    svg.setAttribute("height", h);
    var pw = w - M.l - M.r, ph = h - M.t - M.b;

    if (!pts.length) { svg.innerHTML = ""; document.getElementById("rho").textContent = ""; return; }

    // Bounds from the DATA, then held inside the axis's own clamp where it declares
    // one. These distributions have long tails and fitting to the extreme spends the
    // plot on three names; a clamped point is drawn ON the edge and outlined, never
    // dropped, because a mark parked off-canvas reads as a company the page forgot.
    function bounds(vals, a) {
      var lo = Math.min.apply(null, vals), hi = Math.max.apply(null, vals);
      if (a.lo !== undefined) { lo = a.lo; }
      if (a.hi !== undefined) { hi = a.hi; }
      if (a.clamp !== undefined) {
        lo = Math.max(lo, -a.clamp);
        hi = Math.min(hi, a.clamp);
      }
      if (hi <= lo) { hi = lo + 1; }
      var pad = (hi - lo) * 0.05;
      return [lo - pad, hi + pad];
    }
    var bx = bounds(pts.map(function (p) { return p.x; }), ax);
    var by = bounds(pts.map(function (p) { return p.y; }), ay);
    var X = function (v) { return M.l + ((Math.min(Math.max(v, bx[0]), bx[1]) - bx[0]) / (bx[1] - bx[0])) * pw; };
    var Y = function (v) { return M.t + ph * (1 - (Math.min(Math.max(v, by[0]), by[1]) - by[0]) / (by[1] - by[0])); };
    var fmt = function (v) {
      var a = Math.abs(v);
      return a >= 100 ? v.toFixed(0) : a >= 10 ? v.toFixed(0) : a >= 1 ? v.toFixed(1) : v.toFixed(2);
    };

    var parts = [], t, yv, xv;
    for (t = 0; t <= 4; t++) {
      yv = by[0] + (by[1] - by[0]) * (t / 4);
      xv = bx[0] + (bx[1] - bx[0]) * (t / 4);
      parts.push('<line class="guide" x1="' + M.l + '" x2="' + (w - M.r) + '" y1="' + Y(yv) + '" y2="' + Y(yv) + '"/>');
      parts.push('<text class="tk" x="' + (M.l - 7) + '" y="' + (Y(yv) + 3.5) + '" text-anchor="end">' + fmt(yv) + "</text>");
      parts.push('<text class="tk" x="' + X(xv) + '" y="' + (h - 22) + '" text-anchor="middle">' + fmt(xv) + "</text>");
    }
    parts.push('<text class="ax" x="' + M.l + '" y="' + (h - 5) + '">' + ax.label + "</text>");
    parts.push('<text class="ax" transform="translate(13,' + (M.t + ph) + ') rotate(-90)">' + ay.label + "</text>");

    var index = new Map();
    ROWS.forEach(function (r, i) { index.set(r, i); });
    pts.forEach(function (p) {
      var cls = p.row.dcfband ? BANDS[p.row.dcfband] : "nodcf";
      var clamped = (ax.clamp !== undefined && Math.abs(p.x) > ax.clamp) ||
                    (ay.clamp !== undefined && Math.abs(p.y) > ay.clamp);
      parts.push('<circle class="dot ' + cls + (clamped ? " clamped" : "") +
                 '" data-i="' + index.get(p.row) + '" cx="' + X(p.x).toFixed(1) +
                 '" cy="' + Y(p.y).toFixed(1) + '" r="' + (w < 520 ? 2.6 : 3.1) + '"/>');
    });
    svg.innerHTML = parts.join("");

    // The readout is the whole point of letting the axes move: it says whether this
    // pair relates at all. Anything inside three standard errors is called noise in as
    // many words, because a round cloud with a number under it still reads as a
    // finding to anyone moving quickly.
    var out = document.getElementById("rho");
    // Drift IS the estimate change minus the price change, so those two pairs are a
    // definition rather than a relationship - plotting them prints rho -0.88 and reads
    // as the strongest finding on the page. Say what it is instead of scoring it.
    var pair = [xKey, yKey].sort().join("|");
    if (pair === "gap|pxchg" || pair === "gap|rev") {
      out.textContent = "drift is the estimate change less the price change, so this pair is arithmetic";
      out.className = "rho noise";
      markPicked();
      return;
    }
    var st = rho(pts.map(function (p) { return [p.x, p.y]; }));
    if (!st) {
      out.textContent = "";
      out.className = "rho";
    } else {
      var noise = Math.abs(st.r) < 3 / Math.sqrt(st.n);
      out.textContent = "rho " + (st.r >= 0 ? "+" : "") + st.r.toFixed(2) +
        " over " + st.n + (noise ? ", within noise" : "");
      out.className = "rho" + (noise ? " noise" : "");
    }
    markPicked();
  }

  function markPicked() {
    svg.querySelectorAll(".dot.on").forEach(function (d) { d.classList.remove("on"); });
    if (picked === null) return;
    var d = svg.querySelector('.dot[data-i="' + picked + '"]');
    if (d) d.classList.add("on");
  }

  function nearest(ev) {
    var b = svg.getBoundingClientRect();
    var vb = svg.viewBox.baseVal;
    var x = (ev.clientX - b.left) * (vb.width / b.width);
    var y = (ev.clientY - b.top) * (vb.height / b.height);
    var best = null, bd = 14 * 14;
    svg.querySelectorAll(".dot").forEach(function (d) {
      var dx = d.cx.baseVal.value - x, dy = d.cy.baseVal.value - y;
      var dist = dx * dx + dy * dy;
      if (dist < bd) { bd = dist; best = +d.dataset.i; }
    });
    return best;
  }

  function showTip(i, ev) {
    var r = ROWS[i];
    tip.innerHTML =
      '<b>' + r.ticker + "</b> " + r.name +
      '<span class="tl">Shortfall <b>' + r.strain.toFixed(0) + "</b> of 100, " +
        r.applicable + " of 6 tests</span>" +
      '<span class="tl">Drift <b>' + (r.gap > 0 ? "+" : "") + r.gap.toFixed(1) + "pp</b> " +
        (r.gap > 0 ? "price behind" : r.gap < 0 ? "price ahead" : "level") + "</span>" +
      '<span class="tl">DCF ' + (r.dcf === null ? "<b>no reading</b>"
        : "<b>" + r.dcf.toFixed(2) + "x</b> the market price") + "</span>";
    tip.hidden = false;
    // Follows the pointer, and flips before it can run off the right edge.
    var box = tip.getBoundingClientRect();
    var wrap = svg.parentElement.getBoundingClientRect();
    var left = ev.clientX - wrap.left + 14;
    if (left + box.width > wrap.width) left = ev.clientX - wrap.left - box.width - 14;
    tip.style.left = Math.max(0, left) + "px";
    tip.style.top = Math.max(0, ev.clientY - wrap.top - box.height - 10) + "px";
  }

  svg.addEventListener("mousemove", function (ev) {
    var i = nearest(ev);
    if (i === null) { tip.hidden = true; return; }
    showTip(i, ev);
  });
  svg.addEventListener("mouseleave", function () { tip.hidden = true; });
  svg.addEventListener("click", function (ev) {
    var i = nearest(ev);
    if (i === null) return;
    // Drops the ticker into the search box rather than filtering invisibly, so the
    // control that did it is the one a keyboard reaches, and clearing is obvious.
    q.value = ROWS[i].ticker;
    picked = i;
    render();
    markPicked();
  });

  var rz;
  window.addEventListener("resize", function () {
    clearTimeout(rz);
    rz = setTimeout(plot, 150);
  });

  var W = { strain: 33, drift: 33, dcf: 33 };
  var onlyAll = document.getElementById("onlyAll");

  // Rescore and re-rank the whole set. The three components arrive as percentiles from
  // the build, so this is arithmetic rather than a re-sort of the source data - a
  // slider move costs one pass over 609 rows.
  //
  // A component with no reading is left OUT of the weighted mean rather than scored
  // zero, and the remaining weights are renormalised over what is present. Scoring the
  // absence would rank a company by how much data exists about it: 53% of utilities
  // have no DCF reading, and they would all sink together for a reason that is about
  // the model rather than about them.
  function rescore() {
    ROWS.forEach(function (r) {
      var num = 0, den = 0;
      if (r.pStrain !== null) { num += W.strain * r.pStrain; den += W.strain; }
      if (r.pDrift !== null) { num += W.drift * r.pDrift; den += W.drift; }
      if (r.pDcf !== null) { num += W.dcf * r.pDcf; den += W.dcf; }
      r.score = den > 0 ? num / den : 0;
    });
    var ordered = ROWS.slice().sort(function (a, b) {
      return b.score - a.score || a.ticker.localeCompare(b.ticker);
    });
    ordered.forEach(function (r, i) { r.rank = i + 1; });
  }

  function readWeights() {
    var raw = {};
    ["strain", "drift", "dcf"].forEach(function (k) {
      var id = "w" + k.charAt(0).toUpperCase() + k.slice(1);
      raw[k] = +document.getElementById(id).value;
    });
    var total = raw.strain + raw.drift + raw.dcf;
    ["strain", "drift", "dcf"].forEach(function (k) {
      var id = "w" + k.charAt(0).toUpperCase() + k.slice(1);
      W[k] = raw[k];
      document.getElementById(id + "V").textContent =
        total > 0 ? Math.round((raw[k] / total) * 100) + "%" : "-";
    });
    rescore();
    render();
    plot();
  }
  ["wStrain", "wDrift", "wDcf"].forEach(function (id) {
    document.getElementById(id).addEventListener("input", readWeights);
  });
  document.getElementById("wReset").addEventListener("click", function () {
    ["wStrain", "wDrift", "wDcf"].forEach(function (id) {
      document.getElementById(id).value = 35;
    });
    readWeights();
  });
  onlyAll.addEventListener("change", function () { render(); plot(); });

  function visible() {
    var term = q.value.trim().toLowerCase();
    return ROWS.filter(function (r) {
      if (onlyAll.checked && !r.complete) return false;
      if (!term) return true;
      // Match from the START of the ticker or of a word in the name. Substring
      // matching returns Camden Property Trust for "AMD"; this is the rule the
      // other two sites already use.
      if (r.ticker.toLowerCase().indexOf(term) === 0) return true;
      return r.name.toLowerCase().split(/[^a-z0-9]+/).some(function (w) {
        return w.indexOf(term) === 0;
      });
    });
  }

  // Charlie: the three measures should say more on hover. Each says what the figure
  // is MADE OF rather than restating it - what the score was computed over, the two
  // moves the drift is the difference between, and what the model actually concluded.
  function strainTip(r) {
    return "Ranked against " + r.sector + ", on " + r.applicable +
           " of Shortfall's 6 accounting tests. 100 is the most strained.";
  }
  function driftTip(r) {
    var a = r.rev === null || r.rev === undefined ? null : r.rev;
    var b = r.pxchg === null || r.pxchg === undefined ? null : r.pxchg;
    if (a === null || b === null) return "Estimates against price over 90 days.";
    var s = (a > 0 ? "+" : "") + a.toFixed(1) + "% vs the price " +
            (b > 0 ? "+" : "") + b.toFixed(1) + "% over 90 days";
    return "Consensus earnings estimates " + s + ", so the price is " +
           (r.gap > 0 ? "behind" : r.gap < 0 ? "ahead of" : "level with") + " the estimates.";
  }
  function dcfTip(r) {
    if (r.dcf === null) return "DCF Studio could not produce a usable value for this company.";
    return "DCF Studio's model values the shares at " + r.dcf.toFixed(2) +
           " times the market price, which is the " + r.dcfband +
           " third of the " + N_DCF + " it can value.";
  }

  function render() {
    var rows = visible().slice().sort(function (a, b) {
      var x = a[sortKey], y = b[sortKey];
      if (x === null || x === undefined) return 1;   // no value sorts LAST both ways
      if (y === null || y === undefined) return -1;
      if (typeof x === "string") return x.localeCompare(y) * sortDir;
      return (x - y) * sortDir;
    });
    count.textContent = rows.length === ROWS.length
      ? rows.length + " companies"
      : rows.length + " of " + ROWS.length;
    clear.hidden = !q.value && picked === null;

    if (!rows.length) { tb.innerHTML = '<tr><td class="empty" colspan="' + (HAS_DCF ? 8 : 7) + '">No companies match.</td></tr>'; return; }
    tb.innerHTML = rows.map(function (r) {
      var t = encodeURIComponent(r.ticker);
      return '<tr>' +
        '<td class="num rank">' + r.rank + "</td>" +
        '<td class="tick c-tick-cell">' + r.ticker + "</td>" +
        '<td><span class="tick-inline">' + r.ticker + '</span><span class="cname">' + r.name + "</span></td>" +
        '<td class="c-sect-cell">' + r.sector + "</td>" +
        // Tests is no longer a column of its own - it is a caveat on the score rather
        // than a measurement beside it, so it rides along as the cell's title.
        '<td class="num" title="' + strainTip(r) + '">' + r.strain.toFixed(0) + "</td>" +
        '<td class="num ' + r.reading + '" title="' + driftTip(r) + '">' +
          (r.gap > 0 ? "+" : "") + r.gap.toFixed(1) + "</td>" +
        (HAS_DCF ? '<td class="num c-dcf-cell" title="' + dcfTip(r) + '">' + (r.dcf === null
          ? '<span class="none">-</span>'
          : '<span class="dcf-' + r.dcfband + '">' + r.dcf.toFixed(2) + "x</span>") + "</td>" : "") +
        '<td class="also c-also-cell">' +
          '<a href="https://charlietrenorden.com/shortfall/?q=' + t + '">Shortfall</a>' +
          '<a href="https://charlietrenorden.com/consensus-drift/?q=' + t + '">Consensus</a>' +
          '<a href="https://dcf.charlietrenorden.com/' + t + '">DCF</a>' +
        "</td>" +
      "</tr>";
    }).join("");
  }

  document.querySelectorAll("thead th[data-k]").forEach(function (th) {
    th.addEventListener("click", function () {
      var k = th.dataset.k;
      // Arriving at a sort from elsewhere gives the direction someone asking for it
      // expects first; only a second click on the pressed column flips it.
      if (sortKey === k) { sortDir = -sortDir; }
      // Rank ascends first, because rank 1 is the top of the page and nobody clicking
      // "Rank" wants 609 first. The measures descend first; the text columns ascend.
      else { sortKey = k; sortDir = (k === "ticker" || k === "name" || k === "sector" || k === "rank") ? 1 : -1; }
      document.querySelectorAll("thead th[data-k]").forEach(function (o) {
        o.removeAttribute("aria-sort");
        o.querySelector(".ar").innerHTML = "&#9650;";
      });
      th.setAttribute("aria-sort", sortDir === 1 ? "ascending" : "descending");
      th.querySelector(".ar").innerHTML = sortDir === 1 ? "&#9650;" : "&#9660;";
      render();
    });
  });

  q.addEventListener("input", render);
  clear.addEventListener("click", function () {
    q.value = ""; picked = null;
    render(); markPicked();
  });

  // A ?q= arriving from Shortfall or Consensus Drift lands on that company.
  var incoming = new URLSearchParams(location.search).get("q");
  if (incoming) q.value = incoming;

  drawKey();
  fillPickers();
  readWeights();
  plot();
  render();

  var btn = document.getElementById("themeBtn"), lbl = document.getElementById("themeLbl");
  function label() {
    lbl.textContent = document.documentElement.getAttribute("data-theme") === "dark" ? "Light" : "Dark";
  }
  label();
  btn.addEventListener("click", function () {
    var dark = document.documentElement.getAttribute("data-theme") === "dark";
    document.documentElement.setAttribute("data-theme", dark ? "light" : "dark");
    try { localStorage.setItem("theme", dark ? "light" : "dark"); } catch (e) {}
    label();
  });
})();
</script>
</body>
</html>
