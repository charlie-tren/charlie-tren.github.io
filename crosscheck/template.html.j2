<body>
<div class="wrap">
  <div class="bar">
    <a class="home" href="https://charlietrenorden.com/"><span class="back">&larr;</span>Other projects</a>
    <button class="toggle" id="themeBtn" type="button" aria-label="Toggle light and dark theme"><span class="dot"></span><span id="themeLbl">Dark</span></button>
  </div>

  <h1>Crosscheck</h1>
  <p class="lede">Accounting strain against the gap to analyst estimates, for {{ n }} companies.</p>

  <div class="grid" id="grid" role="group" aria-label="Filter by accounting strain and price reading"></div>

  <div class="allbar">
    <button class="clear" id="clear" type="button" hidden>Show all {{ n }}</button>
    <span class="count" id="count"></span>
  </div>

  <div class="toolbar">
    <input class="search" id="q" type="search" placeholder="Ticker or company" aria-label="Find a company">
  </div>

  <div class="tablewrap">
    <table id="tbl">
      <colgroup>
        <col class="c-tick"><col class="c-name"><col class="c-sect"><col class="c-score">
        <col class="c-tests"><col class="c-gap"><col class="c-read">{% if has_dcf %}<col class="c-dcf">{% endif %}<col class="c-cap">
      </colgroup>
      <thead><tr>
        <th data-k="ticker" class="c-tick-cell">Ticker<span class="ar">&#9650;</span></th>
        <th data-k="name">Company<span class="ar">&#9650;</span></th>
        <th data-k="sector" class="c-sect-cell">Sector<span class="ar">&#9650;</span></th>
        <th data-k="strain" class="num"><span class="hfull">Shortfall</span><span class="hshort">Score</span><span class="ar">&#9650;</span></th>
        <th data-k="applicable" class="num c-tests-cell">Tests<span class="ar">&#9650;</span></th>
        <th data-k="gap" class="num">Gap (pp)<span class="ar">&#9650;</span></th>
        <th data-k="reading">Reading<span class="ar">&#9650;</span></th>
        {% if has_dcf %}<th data-k="dcf" class="c-dcf-cell">DCF<span class="ar">&#9650;</span></th>{% endif %}
        <th data-k="mcap" class="num c-cap-cell">Cap (US$bn)<span class="ar">&#9650;</span></th>
      </tr></thead>
      <tbody id="tb"></tbody>
    </table>
  </div>

  <h2>Notes</h2>
  <p class="foot">
    Shortfall scores each company against six tests of accounting quality and ranks it
    within its sector; 100 is the most strained. Tests is how many of the six could be
    run at all. Gap is the distance between the price and where analyst estimates sit,
    in percentage points, so a positive number means the price is behind the estimates.
    The two measures are close to independent across these companies, which is why the
    corners are worth reading: neither site can tell you what the other one says.
    {% if has_dcf %}DCF is where <a href="https://dcf.charlietrenorden.com/">DCF
    Studio</a>'s model puts a company against the other {{ n_dcf }} it can value, in
    thirds: cheaper means it puts the shares further above their market price. It is a
    ranking rather than a valuation, because that model on its default assumptions runs
    below market prices across the board, so the order it puts companies in carries more
    than any single figure it prints. A dash is a company it declined to value.{% endif %}
    Built from <a href="https://charlietrenorden.com/shortfall/">Shortfall</a>
    ({{ n_shortfall }} companies) and
    <a href="https://charlietrenorden.com/consensus-drift/">Consensus Drift</a>
    ({{ n_drift }}), {{ built }}. General information, not advice.
  </p>
</div>

<script id="rows" type="application/json">{{ rows_json }}</script>
<script>
(function () {
  var ROWS = JSON.parse(document.getElementById("rows").textContent);
  var HAS_DCF = {{ 'true' if has_dcf else 'false' }};
  var CUT = {{ corners.cut }};
  var tb = document.getElementById("tb"), grid = document.getElementById("grid");
  var q = document.getElementById("q"), count = document.getElementById("count");
  var clear = document.getElementById("clear");
  var sortKey = "strain", sortDir = -1, cell = null;

  var READINGS = [["behind", "Price behind"], ["inline", "Inline"], ["ahead", "Price ahead"]];
  var BANDS = [["high", "Top quarter"], ["low", "The rest"]];

  function band(r) { return r.strain >= CUT ? "high" : "low"; }

  function buildGrid() {
    var html = '<div class="gh"></div>';
    READINGS.forEach(function (rd) { html += '<div class="gh">' + rd[1] + "</div>"; });
    BANDS.forEach(function (b) {
      html += '<div class="gh rowlab">' + b[1] + "</div>";
      READINGS.forEach(function (rd) {
        var n = ROWS.filter(function (r) { return band(r) === b[0] && r.reading === rd[0]; }).length;
        html += '<button class="cell ' + rd[0] + '" type="button" aria-pressed="false"' +
                ' data-b="' + b[0] + '" data-r="' + rd[0] + '">' +
                '<span class="cn">' + n + "</span></button>";
      });
    });
    grid.innerHTML = html;
    grid.querySelectorAll(".cell").forEach(function (el) {
      el.addEventListener("click", function () {
        var key = el.dataset.b + "|" + el.dataset.r;
        cell = cell === key ? null : key;
        grid.querySelectorAll(".cell").forEach(function (o) {
          o.setAttribute("aria-pressed", String(o.dataset.b + "|" + o.dataset.r === cell));
        });
        render();
      });
    });
  }

  function visible() {
    var term = q.value.trim().toLowerCase();
    return ROWS.filter(function (r) {
      if (cell && band(r) + "|" + r.reading !== cell) return false;
      if (!term) return true;
      // Match from the START of the ticker or of a word in the name. Substring
      // matching returns Camden Property Trust for "AMD"; this is the rule the
      // other two sites already use.
      if (r.ticker.toLowerCase().indexOf(term) === 0) return true;
      return r.name.toLowerCase().split(/[^a-z0-9]+/).some(function (w) {
        return w.indexOf(term) === 0;
      });
    });
  }

  function render() {
    var rows = visible().slice().sort(function (a, b) {
      var x = a[sortKey], y = b[sortKey];
      if (x === null || x === undefined) return 1;   // no value sorts LAST both ways
      if (y === null || y === undefined) return -1;
      if (typeof x === "string") return x.localeCompare(y) * sortDir;
      return (x - y) * sortDir;
    });
    count.textContent = rows.length === ROWS.length
      ? rows.length + " companies"
      : rows.length + " of " + ROWS.length;
    clear.hidden = rows.length === ROWS.length;

    if (!rows.length) { tb.innerHTML = '<tr><td class="empty" colspan="' + (HAS_DCF ? 9 : 8) + '">No companies match.</td></tr>'; return; }
    tb.innerHTML = rows.map(function (r) {
      return '<tr>' +
        '<td class="tick c-tick-cell">' + r.ticker + "</td>" +
        '<td><span class="tick-inline">' + r.ticker + '</span><span class="cname">' + r.name + "</span></td>" +
        '<td class="c-sect-cell">' + r.sector + "</td>" +
        '<td class="num">' + r.strain.toFixed(0) + "</td>" +
        '<td class="num c-tests-cell">' + r.applicable + "</td>" +
        '<td class="num">' + (r.gap > 0 ? "+" : "") + r.gap.toFixed(1) + "</td>" +
        '<td><span class="read ' + r.reading + '">' + r.reading + "</span></td>" +
        (HAS_DCF ? '<td class="c-dcf-cell">' + (r.dcfband
          ? '<span class="read dcf-' + r.dcfband + '">' + r.dcfband + "</span>"
          : '<span class="none">-</span>') + "</td>" : "") +
        '<td class="num c-cap-cell">' + (r.mcap === null || r.mcap === undefined ? "" : r.mcap.toFixed(1)) + "</td>" +
      "</tr>";
    }).join("");
  }

  document.querySelectorAll("thead th").forEach(function (th) {
    th.addEventListener("click", function () {
      var k = th.dataset.k;
      // Arriving at a sort from elsewhere gives the direction someone asking for it
      // expects first; only a second click on the pressed column flips it.
      if (sortKey === k) { sortDir = -sortDir; }
      else { sortKey = k; sortDir = (k === "ticker" || k === "name" || k === "sector" || k === "reading") ? 1 : -1; }
      document.querySelectorAll("thead th").forEach(function (o) {
        o.removeAttribute("aria-sort");
        o.querySelector(".ar").innerHTML = "&#9650;";
      });
      th.setAttribute("aria-sort", sortDir === 1 ? "ascending" : "descending");
      th.querySelector(".ar").innerHTML = sortDir === 1 ? "&#9650;" : "&#9660;";
      render();
    });
  });

  q.addEventListener("input", render);
  clear.addEventListener("click", function () {
    q.value = ""; cell = null;
    grid.querySelectorAll(".cell").forEach(function (o) { o.setAttribute("aria-pressed", "false"); });
    render();
  });

  // A ?q= arriving from Shortfall or Consensus Drift lands on that company.
  var incoming = new URLSearchParams(location.search).get("q");
  if (incoming) q.value = incoming;

  buildGrid();
  render();

  var btn = document.getElementById("themeBtn"), lbl = document.getElementById("themeLbl");
  function label() {
    lbl.textContent = document.documentElement.getAttribute("data-theme") === "dark" ? "Light" : "Dark";
  }
  label();
  btn.addEventListener("click", function () {
    var dark = document.documentElement.getAttribute("data-theme") === "dark";
    document.documentElement.setAttribute("data-theme", dark ? "light" : "dark");
    try { localStorage.setItem("theme", dark ? "light" : "dark"); } catch (e) {}
    label();
  });
})();
</script>
</body>
</html>
