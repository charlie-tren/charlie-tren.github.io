<body>
<div class="wrap">
  <div class="bar">
    <a class="home" href="https://charlietrenorden.com/"><span class="back">&larr;</span>Other projects</a>
    <button class="toggle" id="themeBtn" type="button" aria-label="Toggle light and dark theme"><span class="dot"></span><span id="themeLbl">Dark</span></button>
  </div>

  <h1>Crosscheck</h1>
  <p class="lede">Accounting strain against the drift from analyst estimates, for {{ n }} companies.</p>

  <figure class="plotwrap">
    <!-- The svg is aria-hidden and the table below carries every value it draws, which
         is the honest arrangement: this is a locator, not the data. Its one action -
         click a company - is mirrored by the search box, which is reachable by
         keyboard. Marking it role="img" would be worse than either, because that
         promises there is nothing inside worth reaching. -->
    <svg id="plot" aria-hidden="true"></svg>
    <div class="key" id="key"></div>
    <div class="tip" id="tip" hidden></div>
  </figure>

  <div class="allbar">
    <button class="clear" id="clear" type="button" hidden>Show all {{ n }}</button>
    <span class="count" id="count"></span>
  </div>

  <div class="toolbar">
    <input class="search" id="q" type="search" placeholder="Ticker or company" aria-label="Find a company">
  </div>

  <div class="tablewrap">
    <table id="tbl">
      <colgroup>
        <col class="c-rank"><col class="c-tick"><col class="c-name"><col class="c-sect">
        <col class="c-score"><col class="c-gap">{% if has_dcf %}<col class="c-dcf">{% endif %}<col class="c-also">
      </colgroup>
      <thead><tr>
        <th data-k="rank" class="num">Rank<span class="ar">&#9650;</span></th>
        <th data-k="ticker" class="c-tick-cell">Ticker<span class="ar">&#9650;</span></th>
        <th data-k="name">Company<span class="ar">&#9650;</span></th>
        <th data-k="sector" class="c-sect-cell">Sector<span class="ar">&#9650;</span></th>
        <th data-k="strain" class="num"><span class="hfull">Shortfall</span><span class="hshort">Score</span><span class="ar">&#9650;</span></th>
        <th data-k="gap" class="num">Drift (pp)<span class="ar">&#9650;</span></th>
        {% if has_dcf %}<th data-k="dcf" class="c-dcf-cell">DCF<span class="ar">&#9650;</span></th>{% endif %}
        <th class="c-also-cell nosort">Also on</th>
      </tr></thead>
      <tbody id="tb"></tbody>
    </table>
  </div>

  <h2>Notes</h2>
  <p class="foot">
    <!-- Cut from eight sentences to three on 10/09/2026: "way too long". What went was
         everything explaining a column that its own header and values already say -
         what Tests counted, what the DCF bands mean, why the two measures are
         independent. What stays is the three things a reader cannot deduce from the
         page: which way each scale runs, and that Rank is a combination. -->
    Shortfall runs 0 to 100, higher is more strained. A positive drift means the price
    sits behind analyst estimates. Rank combines all three columns, and the top of the
    table is where they agree. General information, not advice.
  </p>
</div>

<script id="rows" type="application/json">{{ rows_json }}</script>
<script>
(function () {
  var ROWS = JSON.parse(document.getElementById("rows").textContent);
  var HAS_DCF = {{ 'true' if has_dcf else 'false' }};
  var N_DCF = {{ n_dcf }};
  var CUT = {{ corners.cut }};
  var tb = document.getElementById("tb");
  var q = document.getElementById("q"), count = document.getElementById("count");
  var clear = document.getElementById("clear");
  var sortKey = "rank", sortDir = 1;

  var svg = document.getElementById("plot"), tip = document.getElementById("tip");
  var picked = null;

  // The drift axis is CLAMPED rather than fitted. Measured over the 609: the values run
  // -211.1 to +56.7, but -60 to +60 already contains 606 of them, so fitting to the
  // data spends 70% of the plot on three distressed names and squashes everyone else
  // into a band. The three sit ON the edge as hollow marks with their true figure in
  // the readout, because a point silently parked off-canvas is worse than a squashed
  // axis - it reads as a company the page forgot.
  var YCLAMP = 60;
  var BANDS = { cheaper: "cheaper", middle: "middle", dearer: "dearer" };

  function drawKey() {
    var items = [["cheaper", "Cheaper on the model"], ["middle", "Middle third"],
                 ["dearer", "Dearer on the model"], ["nodcf", "No model reading"]];
    document.getElementById("key").innerHTML = items.map(function (i) {
      return '<span class="ki"><i class="sw ' + i[0] + '"></i>' + i[1] + "</span>";
    }).join("");
  }

  function plot() {
    // Drawn at CONTAINER PIXEL SCALE - the viewBox is set from the measured width, so
    // one unit is one CSS pixel and a 10px label is 10px on a phone. A fixed wide
    // viewBox scaled to fit is what renders axis type at 4px.
    var w = Math.max(280, svg.clientWidth || svg.parentElement.clientWidth);
    var h = w < 520 ? 300 : 430;
    var M = { l: 44, r: 12, t: 12, b: 34 };
    svg.setAttribute("viewBox", "0 0 " + w + " " + h);
    svg.setAttribute("height", h);
    var pw = w - M.l - M.r, ph = h - M.t - M.b;
    var X = function (v) { return M.l + (v / 100) * pw; };
    var Y = function (v) {
      var c = Math.max(-YCLAMP, Math.min(YCLAMP, v));
      return M.t + ph * (1 - (c + YCLAMP) / (2 * YCLAMP));
    };

    var parts = [];
    // Guides: the strain quartile cut, and Consensus Drift's own 10pp bands. Drawn
    // under the dots so a mark is never hidden behind a rule.
    [-10, 10].forEach(function (v) {
      parts.push('<line class="guide" x1="' + M.l + '" x2="' + (w - M.r) +
                 '" y1="' + Y(v) + '" y2="' + Y(v) + '"/>');
    });
    parts.push('<line class="guide" y1="' + M.t + '" y2="' + (M.t + ph) +
               '" x1="' + X(CUT) + '" x2="' + X(CUT) + '"/>');
    parts.push('<line class="zero" x1="' + M.l + '" x2="' + (w - M.r) +
               '" y1="' + Y(0) + '" y2="' + Y(0) + '"/>');

    // Axes. Ticks are round numbers on both, and the labels say the DIRECTION, which
    // is what a reader needs here - the units mean nothing without it.
    [-60, -30, 0, 30, 60].forEach(function (v) {
      parts.push('<text class="tk" x="' + (M.l - 7) + '" y="' + (Y(v) + 3.5) +
                 '" text-anchor="end">' + (v > 0 ? "+" : "") + v + "</text>");
    });
    [0, 25, 50, 75, 100].forEach(function (v) {
      parts.push('<text class="tk" x="' + X(v) + '" y="' + (h - 16) +
                 '" text-anchor="middle">' + v + "</text>");
    });
    parts.push('<text class="ax" x="' + M.l + '" y="' + (h - 3) + '">Shortfall, higher is more strained</text>');
    parts.push('<text class="ax" transform="translate(11,' + (M.t + 4) + ') rotate(-90)" text-anchor="end">Price behind estimates</text>');
    parts.push('<text class="ax" transform="translate(11,' + (M.t + ph) + ') rotate(-90)">Price ahead</text>');

    ROWS.forEach(function (r, i) {
      var cls = r.dcfband ? BANDS[r.dcfband] : "nodcf";
      var clamped = Math.abs(r.gap) > YCLAMP;
      parts.push('<circle class="dot ' + cls + (clamped ? " clamped" : "") + '" data-i="' + i +
                 '" cx="' + X(r.strain).toFixed(1) + '" cy="' + Y(r.gap).toFixed(1) +
                 '" r="' + (w < 520 ? 2.6 : 3.1) + '"/>');
    });
    svg.innerHTML = parts.join("");
    markPicked();
  }

  function markPicked() {
    svg.querySelectorAll(".dot.on").forEach(function (d) { d.classList.remove("on"); });
    if (picked === null) return;
    var d = svg.querySelector('.dot[data-i="' + picked + '"]');
    if (d) d.classList.add("on");
  }

  function nearest(ev) {
    var b = svg.getBoundingClientRect();
    var vb = svg.viewBox.baseVal;
    var x = (ev.clientX - b.left) * (vb.width / b.width);
    var y = (ev.clientY - b.top) * (vb.height / b.height);
    var best = null, bd = 14 * 14;
    svg.querySelectorAll(".dot").forEach(function (d) {
      var dx = d.cx.baseVal.value - x, dy = d.cy.baseVal.value - y;
      var dist = dx * dx + dy * dy;
      if (dist < bd) { bd = dist; best = +d.dataset.i; }
    });
    return best;
  }

  function showTip(i, ev) {
    var r = ROWS[i];
    tip.innerHTML =
      '<b>' + r.ticker + "</b> " + r.name +
      '<span class="tl">Shortfall <b>' + r.strain.toFixed(0) + "</b> of 100, " +
        r.applicable + " of 6 tests</span>" +
      '<span class="tl">Drift <b>' + (r.gap > 0 ? "+" : "") + r.gap.toFixed(1) + "pp</b> " +
        (r.gap > 0 ? "price behind" : r.gap < 0 ? "price ahead" : "level") + "</span>" +
      '<span class="tl">DCF ' + (r.dcf === null ? "<b>no reading</b>"
        : "<b>" + r.dcf.toFixed(2) + "x</b> the market price") + "</span>";
    tip.hidden = false;
    // Follows the pointer, and flips before it can run off the right edge.
    var box = tip.getBoundingClientRect();
    var wrap = svg.parentElement.getBoundingClientRect();
    var left = ev.clientX - wrap.left + 14;
    if (left + box.width > wrap.width) left = ev.clientX - wrap.left - box.width - 14;
    tip.style.left = Math.max(0, left) + "px";
    tip.style.top = Math.max(0, ev.clientY - wrap.top - box.height - 10) + "px";
  }

  svg.addEventListener("mousemove", function (ev) {
    var i = nearest(ev);
    if (i === null) { tip.hidden = true; return; }
    showTip(i, ev);
  });
  svg.addEventListener("mouseleave", function () { tip.hidden = true; });
  svg.addEventListener("click", function (ev) {
    var i = nearest(ev);
    if (i === null) return;
    // Drops the ticker into the search box rather than filtering invisibly, so the
    // control that did it is the one a keyboard reaches, and clearing is obvious.
    q.value = ROWS[i].ticker;
    picked = i;
    render();
    markPicked();
  });

  var rz;
  window.addEventListener("resize", function () {
    clearTimeout(rz);
    rz = setTimeout(plot, 150);
  });

  function visible() {
    var term = q.value.trim().toLowerCase();
    return ROWS.filter(function (r) {
      if (!term) return true;
      // Match from the START of the ticker or of a word in the name. Substring
      // matching returns Camden Property Trust for "AMD"; this is the rule the
      // other two sites already use.
      if (r.ticker.toLowerCase().indexOf(term) === 0) return true;
      return r.name.toLowerCase().split(/[^a-z0-9]+/).some(function (w) {
        return w.indexOf(term) === 0;
      });
    });
  }

  // Charlie: the three measures should say more on hover. Each says what the figure
  // is MADE OF rather than restating it - what the score was computed over, the two
  // moves the drift is the difference between, and what the model actually concluded.
  function strainTip(r) {
    return "Ranked against " + r.sector + ", on " + r.applicable +
           " of Shortfall's 6 accounting tests. 100 is the most strained.";
  }
  function driftTip(r) {
    var a = r.rev === null || r.rev === undefined ? null : r.rev;
    var b = r.pxchg === null || r.pxchg === undefined ? null : r.pxchg;
    if (a === null || b === null) return "Estimates against price over 90 days.";
    var s = (a > 0 ? "+" : "") + a.toFixed(1) + "% vs the price " +
            (b > 0 ? "+" : "") + b.toFixed(1) + "% over 90 days";
    return "Consensus earnings estimates " + s + ", so the price is " +
           (r.gap > 0 ? "behind" : r.gap < 0 ? "ahead of" : "level with") + " the estimates.";
  }
  function dcfTip(r) {
    if (r.dcf === null) return "DCF Studio could not produce a usable value for this company.";
    return "DCF Studio's model values the shares at " + r.dcf.toFixed(2) +
           " times the market price, which is the " + r.dcfband +
           " third of the " + N_DCF + " it can value.";
  }

  function render() {
    var rows = visible().slice().sort(function (a, b) {
      var x = a[sortKey], y = b[sortKey];
      if (x === null || x === undefined) return 1;   // no value sorts LAST both ways
      if (y === null || y === undefined) return -1;
      if (typeof x === "string") return x.localeCompare(y) * sortDir;
      return (x - y) * sortDir;
    });
    count.textContent = rows.length === ROWS.length
      ? rows.length + " companies"
      : rows.length + " of " + ROWS.length;
    clear.hidden = rows.length === ROWS.length;

    if (!rows.length) { tb.innerHTML = '<tr><td class="empty" colspan="' + (HAS_DCF ? 8 : 7) + '">No companies match.</td></tr>'; return; }
    tb.innerHTML = rows.map(function (r) {
      var t = encodeURIComponent(r.ticker);
      return '<tr>' +
        '<td class="num rank">' + r.rank + "</td>" +
        '<td class="tick c-tick-cell">' + r.ticker + "</td>" +
        '<td><span class="tick-inline">' + r.ticker + '</span><span class="cname">' + r.name + "</span></td>" +
        '<td class="c-sect-cell">' + r.sector + "</td>" +
        // Tests is no longer a column of its own - it is a caveat on the score rather
        // than a measurement beside it, so it rides along as the cell's title.
        '<td class="num" title="' + strainTip(r) + '">' + r.strain.toFixed(0) + "</td>" +
        '<td class="num ' + r.reading + '" title="' + driftTip(r) + '">' +
          (r.gap > 0 ? "+" : "") + r.gap.toFixed(1) + "</td>" +
        (HAS_DCF ? '<td class="num c-dcf-cell" title="' + dcfTip(r) + '">' + (r.dcf === null
          ? '<span class="none">-</span>'
          : '<span class="dcf-' + r.dcfband + '">' + r.dcf.toFixed(2) + "x</span>") + "</td>" : "") +
        '<td class="also c-also-cell">' +
          '<a href="https://charlietrenorden.com/shortfall/?q=' + t + '">Shortfall</a>' +
          '<a href="https://charlietrenorden.com/consensus-drift/?q=' + t + '">Consensus</a>' +
          '<a href="https://dcf.charlietrenorden.com/' + t + '">DCF</a>' +
        "</td>" +
      "</tr>";
    }).join("");
  }

  document.querySelectorAll("thead th[data-k]").forEach(function (th) {
    th.addEventListener("click", function () {
      var k = th.dataset.k;
      // Arriving at a sort from elsewhere gives the direction someone asking for it
      // expects first; only a second click on the pressed column flips it.
      if (sortKey === k) { sortDir = -sortDir; }
      // Rank ascends first, because rank 1 is the top of the page and nobody clicking
      // "Rank" wants 609 first. The measures descend first; the text columns ascend.
      else { sortKey = k; sortDir = (k === "ticker" || k === "name" || k === "sector" || k === "rank") ? 1 : -1; }
      document.querySelectorAll("thead th[data-k]").forEach(function (o) {
        o.removeAttribute("aria-sort");
        o.querySelector(".ar").innerHTML = "&#9650;";
      });
      th.setAttribute("aria-sort", sortDir === 1 ? "ascending" : "descending");
      th.querySelector(".ar").innerHTML = sortDir === 1 ? "&#9650;" : "&#9660;";
      render();
    });
  });

  q.addEventListener("input", render);
  clear.addEventListener("click", function () {
    q.value = ""; picked = null;
    render(); markPicked();
  });

  // A ?q= arriving from Shortfall or Consensus Drift lands on that company.
  var incoming = new URLSearchParams(location.search).get("q");
  if (incoming) q.value = incoming;

  drawKey();
  plot();
  render();

  var btn = document.getElementById("themeBtn"), lbl = document.getElementById("themeLbl");
  function label() {
    lbl.textContent = document.documentElement.getAttribute("data-theme") === "dark" ? "Light" : "Dark";
  }
  label();
  btn.addEventListener("click", function () {
    var dark = document.documentElement.getAttribute("data-theme") === "dark";
    document.documentElement.setAttribute("data-theme", dark ? "light" : "dark");
    try { localStorage.setItem("theme", dark ? "light" : "dark"); } catch (e) {}
    label();
  });
})();
</script>
</body>
</html>
