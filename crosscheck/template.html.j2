  }
  // ---- 1-Month Move: every scoring date, each quintile's move over the next month ----
  // Charlie, 07/10/2026: rather than one median path, take every start date the record
  // can score (the reconstructed quarter-ends since 2021 and the August weekly cohorts),
  // cut that date's names into quintiles at the CURRENT weights, and take each quintile's
  // median move over the following month (f1, from daily closes). One dot per start date
  // per quintile; the bar is the average across start dates. The spread is the point: an
  // average carried by one good month looks very different from one every month agrees on.
  function drawM1() {
    var svg = document.getElementById("m1");
    var d = dims(svg, 380, 300), M = { l: 52, r: 14, t: 30, b: 48 };
    var pw = d.w - M.l - M.r, ph = d.h - M.t - M.b;
    var FI = M1P === 6 ? 8 : 7;      // f6 or f1 on the event
    var byDate = {};
    pool().forEach(function (r) {
      if (!r.ev) return;
      r.ev.forEach(function (ev) {
        if (ev[FI] === null || ev[FI] === undefined) return;
        var s0 = scoreAt(ev); if (s0 === null) return;
        (byDate[ev[0]] = byDate[ev[0]] || []).push({ s: s0, f: ev[FI] * 100 });
      });
    });
    var starts = [];   // [{j, med: [5]}]
    Object.keys(byDate).forEach(function (j) {
      var g = byDate[j].sort(function (a, b) { return a.s - b.s; });
      if (g.length < 25) return;             // 5 a quintile at the least
      var qs = [[], [], [], [], []];
      g.forEach(function (e, i) { qs[Math.min(4, Math.floor(i * 5 / g.length))].push(e.f); });
      starts.push({ j: +j, n: g.length, med: qs.map(function (v) { v.sort(function (a, b) { return a - b; }); return v[Math.floor(v.length / 2)]; }) });
    });
    if (!starts.length) {
      svg.innerHTML = "";
      document.getElementById("m1key").style.paddingLeft = "0";
      document.getElementById("m1key").innerHTML = '<span class="ki knote">These weights have no record before 12 Sep 2026, and no ' +
        (M1P === 6 ? "six months have" : "month has") + ' finished since then, so these weights have nothing to show yet.</span>';
      return;
    }
    starts.sort(function (a, b) { return a.j - b.j; });
    var all = [].concat.apply([], starts.map(function (x) { return x.med; }));
    var lo = Math.min(0, Math.min.apply(null, all)), hi = Math.max(0, Math.max.apply(null, all));
    var pad = Math.max(0.5, (hi - lo) * 0.1); lo -= pad; hi += pad;
    var Y = function (v) { return M.t + (hi - v) / (hi - lo) * ph; };
    var cw = pw / 5, Xc = function (q) { return M.l + cw * q + cw / 2; };
    var parts = ['<rect class="ground" x="' + M.l + '" y="' + M.t + '" width="' + pw + '" height="' + ph + '"/>'];
    var gstep = (hi - lo) > 40 ? 10 : (hi - lo) > 16 ? 5 : (hi - lo) > 6 ? 2 : 1;
    for (var g0 = Math.ceil(lo / gstep) * gstep; g0 <= hi; g0 += gstep) {
      parts.push('<line class="' + (g0 === 0 ? "rowrule" : "guide") + '" x1="' + M.l + '" x2="' + (M.l + pw) + '" y1="' + Y(g0).toFixed(1) + '" y2="' + Y(g0).toFixed(1) + '"/>');
      parts.push('<text class="tk" x="' + (M.l - 6) + '" y="' + (Y(g0) + 4).toFixed(1) + '" text-anchor="end">' + (g0 > 0 ? "+" : "") + g0 + "%</text>");
    }
    var SHORT = ["Bottom", "2nd", "Middle", "4th", "Top"];
    var avg = [0, 1, 2, 3, 4].map(function (q) {
      var v = starts.map(function (x) { return x.med[q]; }).filter(function (x) { return x !== undefined && x !== null; });
      return v.reduce(function (a, b) { return a + b; }, 0) / v.length;
    });
    // Dots sit on their column's centre line: the horizontal axis is the quintile, so a
    // sideways offset would claim a second variable. Overlap shows through transparency.
    starts.forEach(function (st, si) {
      st.med.forEach(function (v, q) {
        parts.push('<circle class="m1dot" data-s="' + si + '" data-q="' + q + '" cx="' + Xc(q).toFixed(1) + '" cy="' + Y(v).toFixed(1) + '" r="4.5" fill="' + fifthColour(q) + '"/>');
      });
    });
    avg.forEach(function (v, q) {
      var half = d.w < 520 ? cw * 0.36 : cw * 0.28;
      parts.push('<line class="m1avg" x1="' + (Xc(q) - half).toFixed(1) + '" x2="' + (Xc(q) + half).toFixed(1) + '" y1="' + Y(v).toFixed(1) + '" y2="' + Y(v).toFixed(1) + '"/>');
      // Beside the bar where the column has room; above it, centred, on a phone, where a
      // label to the right ran into the next column.
      var narrow = d.w < 520;
      parts.push('<text class="m1lab" x="' + (narrow ? Xc(q) : Xc(q) + cw * 0.3).toFixed(1) + '" y="' + (narrow ? Y(v) - 8 : Y(v) + 4).toFixed(1) + '"' +
                 (narrow ? ' text-anchor="middle"' : '') + '>' + (v > 0 ? "+" : "") + v.toFixed(1) + "%</text>");
      parts.push('<text class="tk" x="' + Xc(q).toFixed(1) + '" y="' + (M.t + ph + 16).toFixed(1) + '" text-anchor="middle">' + SHORT[q] + "</text>");
    });
    parts.push('<text class="ax ctitle" x="' + (M.l + pw / 2).toFixed(1) + '" y="' + (M.t - 11) + '" text-anchor="middle">' + (d.w < 520
      ? (M1P === 6 ? "Next 6 Months by Quintile" : "Next Month by Quintile")
      : (M1P === 6 ? "Share Price Move Over the Next 6 Months, by Score Quintile" : "Share Price Move Over the Next Month, by Score Quintile")) + '</text>');
    parts.push('<text class="ax" x="' + (M.l + pw / 2).toFixed(1) + '" y="' + (d.h - 3) + '" text-anchor="middle">Quintile</text>');
    svg.innerHTML = parts.join("");
    document.getElementById("m1key").innerHTML = "";
    svg.onmousemove = throttled(function (ev) {
      var t = ev.target;
      document.querySelectorAll("#m1 .m1dot.hot").forEach(function (c) { c.classList.remove("hot"); });
      if (!t.classList || !t.classList.contains("m1dot")) { hideTip(); return; }
      var st = starts[+t.dataset.s];
      document.querySelectorAll('#m1 .m1dot[data-s="' + t.dataset.s + '"]').forEach(function (c) { c.classList.add("hot"); });
      showTip("<b>From " + fmtDate(DATES[st.j]) + " " + DATES[st.j].slice(0, 4) + "</b>, " + st.n + " companies" +
              '<span class="tl">' + st.med.map(function (v, q) { return FIFTH[q] + " " + (v > 0 ? "+" : "") + v.toFixed(1) + "%"; }).join("<br>") + "</span>", ev);
    });
    svg.onmouseleave = function () { hideTip(); document.querySelectorAll("#m1 .m1dot.hot").forEach(function (c) { c.classList.remove("hot"); }); };
  }

  document.querySelectorAll("#m1pick button").forEach(function (b) {
    b.addEventListener("click", function () {
      M1P = +b.dataset.p;
      document.querySelectorAll("#m1pick button").forEach(function (o) { o.setAttribute("aria-pressed", String(o === b)); });
      plot();
    });
  });

  function isRecon(e) { return !!(e.r.ev && e.r.ev.some(function (ev) { return ev[0] === e.j && ev[6]; })); }
  function drawMove() {
    var svg = document.getElementById("move");
    var d = dims(svg, 400, 260), M = { l: 46, r: 14, t: 30, b: 48 };
    var pw = d.w - M.l - M.r, ph = d.h - M.t - M.b;
    // AN EVENT STUDY. Every (name, scoring date) is one event: the score as the
    // components stood that day, then the price move from that day to each later
    // date the record holds. Scoring dates are the reconstructed ones (quarterly to
    // June 2026, weekly through August) and the first observed day, so a name
    // scored in June 2025 is five events, one a quarter. Fifths are struck within
    // each scoring date. At each horizon a fifth's line is the median over the
    // events with an observation there - a quarterly event has one at 90 days, a
    // weekly one at 7 - and a horizon with fewer than 40 events is not drawn.
    var events = [], droppedRecon = 0;
    pool().forEach(function (r) {
      if (!r.ev || !r.mvs) return;
      r.ev.forEach(function (ev) {
        var s0 = scoreAt(ev); if (s0 === null) { if (ev[6]) droppedRecon++; return; }
        var o = obsFor(r, ev[0]); if (!o) return;
        events.push({ r: r, j: ev[0], s: s0, o: o, last: o.last });
      });
    });
    var byDate = {};
    events.forEach(function (e) { (byDate[e.j] = byDate[e.j] || []).push(e); });
    Object.keys(byDate).forEach(function (j) {
      var g = byDate[j].sort(function (p, q) { return p.s - q.s; });
      g.forEach(function (e, i) { e.q = Math.min(4, Math.floor(i * 5 / g.length)); });
    });
    var hmax = Math.max.apply(null, events.map(function (e) { return e.last[0]; }));
    // FIXED horizons, so every point pools whichever cohorts have reached it: weekly
    // to six weeks, where the weekly and daily record is dense, then quarters, where
    // a quarterly event has its observation. Reading every observed day instead
    // drew each cohort's own path in turn and the line was the seams between them.
    var H = [], TOL = {};
    for (var h1 = 7; h1 <= Math.min(42, hmax); h1 += 7) { H.push(h1); TOL[h1] = 3; }
    // Quarterly horizons step by a QUARTER (91.31 days), not 90: the cohorts and their
    // observations sit on quarter-ends, and 90-day steps drift ~1.3 days a quarter off
    // them, so past ~900 days every point fell outside the tolerance and the lines
    // stopped (07/10/2026, once the 2021-2024 record arrived).
    for (var kq = 1; Math.round(kq * 91.3125) <= hmax + 12; kq++) { var h2 = Math.round(kq * 91.3125); H.push(h2); TOL[h2] = 12; }
    var step = 7;
    // At least 100 events at a horizon (20 a quintile on average) before it is drawn:
    // at 40, a horizon reached by a few dozen names drew one stock's jump as a quintile.
    var MIN_N = 100, series = [], counts = [], HK = H.join(",");
    events.forEach(function (e) { e.v = valuesAt(e.o, H, TOL, HK); });
    H.forEach(function (h, hi) {
      var n = 0, meds = [];
      var byQ = [[], [], [], [], []];
      events.forEach(function (e) { var v = e.v[hi]; if (v !== null) byQ[e.q].push(v); });
      for (var q = 0; q < 5; q++) {
        var v = byQ[q];
        v.sort(function (p, r) { return p - r; });
        n += v.length; meds.push(v.length ? v[Math.floor(v.length / 2)] : null);
      }
      counts.push(n); series.push(n >= MIN_N ? meds : [null, null, null, null, null]);
    });
    var all = [].concat.apply([], series).filter(function (v) { return v !== null; });
    if (!all.length) { svg.innerHTML = ""; return; }
    var lo = Math.min(0, Math.min.apply(null, all)), hi = Math.max(0, Math.max.apply(null, all));
    var pad = Math.max(0.5, (hi - lo) * 0.15); lo -= pad; hi += pad;
    // The axis ends on a round number at or past the last observation, so the final tick
    // is the end of the axis rather than wherever the 60-day steps happened to stop.
    // Tick step first (the smallest that leaves 72px between labels at this width), then
    // the axis end rounded UP to a multiple of it, so the last tick is the axis end and
    // the labels are evenly spaced whatever the record's length.
    // The axis runs to the last horizon actually DRAWN, not the last observation: a
    // horizon short of MIN_N events draws nothing and would leave the right of the axis empty.
    var hdraw = 0; H.forEach(function (h, k) { if (counts[k] >= MIN_N) hdraw = h; });
    hdraw = hdraw || hmax;
    // Past about 18 months the axis counts YEARS (Charlie, 07/10/2026); shorter records
    // keep days, where a week is a meaningful step.
    var YR = 365.25, inYears = hdraw > 540;
    var tstep = inYears
      ? ([1, 2].map(function (k) { return k * YR; }).filter(function (t) { return t / hdraw * pw >= 72; })[0] || 2 * YR)
      : ([7, 14, 30, 60, 90, 180, 365].filter(function (t) { return t / Math.max(1, hdraw) * pw >= 72; })[0] || 365);
    var xmax = Math.max(tstep, Math.ceil(hdraw / tstep - 1e-9) * tstep);
    var X = function (h) { return M.l + h / xmax * pw; };
    var Y = function (v) { return M.t + (hi - v) / (hi - lo) * ph; };
    var parts = ['<rect class="ground" x="' + M.l + '" y="' + M.t + '" width="' + pw + '" height="' + ph + '"/>'];
    var gstep = (hi - lo) > 40 ? 10 : (hi - lo) > 16 ? 5 : (hi - lo) > 6 ? 2 : 1;
    for (var g = Math.ceil(lo / gstep) * gstep; g <= hi; g += gstep) {
      parts.push('<line class="' + (g === 0 ? "rowrule" : "guide") + '" x1="' + M.l + '" x2="' + (M.l + pw) + '" y1="' + Y(g).toFixed(1) + '" y2="' + Y(g).toFixed(1) + '"/>');
      parts.push('<text class="tk" x="' + (M.l - 6) + '" y="' + (Y(g) + 4).toFixed(1) + '" text-anchor="end">' + (g > 0 ? "+" : "") + g + "%</text>");
    }
    for (var ti = 0; ti * tstep <= xmax + 1e-6; ti++) {
      var t = ti * tstep;
      var tl = inYears ? (ti === 0 ? "0" : Math.round(t / YR) + "y") : t + "d";
      parts.push('<text class="tk" x="' + X(t).toFixed(1) + '" y="' + (M.t + ph + 16).toFixed(1) + '" text-anchor="' + (t === 0 ? "start" : "middle") + '">' + tl + "</text>");
    }
    // Lines join the drawn horizons; dots mark each one, because between a 90-day
    // observation and a 180-day one nothing was measured.
    [2, 1, 3, 0, 4].forEach(function (q) {
      var pts = [], lastK = -1;
      series.forEach(function (m, k) { if (m[q] !== null) { pts.push(X(H[k]).toFixed(1) + "," + Y(m[q]).toFixed(1)); lastK = k; } });
      if (pts.length > 1) parts.push('<polyline class="mline' + (q === 2 ? " mid" : "") + '" stroke="' + fifthColour(q) + '" points="' + pts.join(" ") + '"/>');
      if (step > 1) series.forEach(function (m, k) { if (m[q] !== null) parts.push('<circle class="mdot" cx="' + X(H[k]).toFixed(1) + '" cy="' + Y(m[q]).toFixed(1) + '" r="2.2" fill="' + fifthColour(q) + '"/>'); });
      else if (lastK >= 0) parts.push('<circle class="mdot" cx="' + X(H[lastK]).toFixed(1) + '" cy="' + Y(series[lastK][q]).toFixed(1) + '" r="3.5" fill="' + fifthColour(q) + '"/>');
    });
    // Rho at the longest horizon most events reach, so it is one horizon and not a
    // mix of a week and a year.
    // The headline horizon is 90 days - the first one every quarterly cohort reaches,
    // so it pools the most events at a length that means something - falling back to
    // the longest horizon with enough events while the record is shorter than that.
    var bestK = -1;
    counts.forEach(function (n, k) { if (H[k] === 91 && n >= MIN_N) bestK = k; });
    if (bestK < 0) counts.forEach(function (n, k) { if (n >= MIN_N) bestK = k; });
    var pairs = [], tolB = TOL[H[bestK]];
    events.forEach(function (e) { var v = e.v[bestK]; if (v !== null) pairs.push([e.s, v]); });
    var rho = spearman(pairs);
    parts.push('<text class="ax ctitle" x="' + (M.l + pw / 2).toFixed(1) + '" y="' + (M.t - 11) + '" text-anchor="middle">Share Price Move by Score Quintile</text>');
    parts.push('<text class="ax" x="' + (M.l + pw / 2).toFixed(1) + '" y="' + (d.h - 3) + '" text-anchor="middle">' + (inYears ? "Years" : "Days") + ' Since Scored</text>');
    parts.push('<line class="cursor" id="mcursor" x1="0" x2="0" y1="' + M.t + '" y2="' + (M.t + ph) + '" visibility="hidden"/>');
    svg.innerHTML = parts.join("");
    var nNames = {}; events.forEach(function (e) { nNames[e.r.ticker] = 1; });
    document.getElementById("movekey").style.paddingLeft = M.l + "px";
    document.getElementById("movekey").innerHTML = [0, 1, 2, 3, 4].map(function (q) {
      var v = series[bestK][q];
      return '<span class="ki"><i class="sw" style="background:' + fifthColour(q) + '"></i>' + FIFTH[q] +
             (v === null ? "" : " <b>" + (v > 0 ? "+" : "") + v.toFixed(1) + "%</b>") + "</span>";
    }).join("") +
      // Only when the weights leave the earlier record nothing to score it on (the 2-year
      // preset): the chart is then a few weeks long, and without a word it reads as broken.
      (droppedRecon > 0 && !events.some(function (e) { return isRecon(e); })
        ? '<span class="ki knote">These weights have no record before 12 Sep 2026, so they start there.</span>' : "");
    var cur = document.getElementById("mcursor");
    svg.onmousemove = throttled(function (ev) {
      var box = svg.getBoundingClientRect(), mx = ev.clientX - box.left;
      if (mx < M.l || mx > M.l + pw) { hideTip(); cur.setAttribute("visibility", "hidden"); return; }
      var k = 0, best = 1e9;
      H.forEach(function (h, i) { if (counts[i] < MIN_N) return; var dx = Math.abs(X(h) - mx); if (dx < best) { best = dx; k = i; } });
      cur.setAttribute("x1", X(H[k])); cur.setAttribute("x2", X(H[k])); cur.setAttribute("visibility", "visible");
      showTip("<b>" + (H[k] >= YR ? (H[k] / YR).toFixed(1) + " years" : H[k] + " days") + "</b>, " + counts[k] + " scores" +
              '<span class="tl">' + series[k].map(function (v, q) {
                return FIFTH[q] + " " + (v === null ? "-" : (v > 0 ? "+" : "") + v.toFixed(1) + "%");
              }).join("<br>") + "</span>", ev);
    });
    svg.onmouseleave = function () { hideTip(); cur.setAttribute("visibility", "hidden"); };
  }

  function markPicked() {}   // the charts mark focus() on every redraw
  // Remembered per browser, never in the URL: a link should open on the page's own
  // default, not on whichever chart the sender happened to be looking at.
  var CHART = "heat";
  try { CHART = localStorage.getItem("crosscheck.chart") || "heat"; } catch (e) {}
  var DRAW = { heat: drawHeat, sect: drawSectors, hist: drawHist };
  if (HAS_MOVES) { DRAW.move = drawMove; DRAW.m1 = drawM1; }
  if (!DRAW[CHART]) CHART = "heat";

  function showChart(k) {
    CHART = k;
    try { localStorage.setItem("crosscheck.chart", k); } catch (e) {}
    Object.keys(DRAW).forEach(function (id) {
      document.getElementById("fig-" + id).hidden = id !== k;
    });
    document.querySelectorAll("#chartpick button").forEach(function (b) {
      b.setAttribute("aria-pressed", String(b.dataset.chart === k));
    });
    hideTip();
    plot();
  }
  document.querySelectorAll("#chartpick button").forEach(function (b) {
    b.addEventListener("click", function () { showChart(b.dataset.chart); });
  });

  // Only the visible chart is drawn. A hidden figure measures zero wide, and drawing
  // into it would size every label off nothing.
  // A chart already drawn for the same inputs is left alone, so flicking back to one
  // costs nothing. VER moves whenever the scores or the pool change (rescore), and the
  // key also carries the width, the search and the theme, which change the drawing.
  var VER = 0, DRAWN = {}, M1P = 1;
  function plot() {
    var svg = document.getElementById(CHART);
    var key = [VER, svg ? svg.parentElement.clientWidth : 0, q.value, picked,
               document.documentElement.getAttribute("data-theme"), M1P].join("|");
    if (DRAWN[CHART] === key) return;
    DRAW[CHART]();
    DRAWN[CHART] = key;
  }
  window.crosscheckRedraw = function () { plot(); render(); };

  var rz;
  window.addEventListener("resize", function () {
    clearTimeout(rz);
    rz = setTimeout(plot, 150);
  });

  var W = { strain: 20, drift: 50, dcf: 0, mom: 30 };
  var onlyAll = document.getElementById("onlyAll");

  // Rescore and re-rank the whole set. The three components arrive as percentiles from
  // the build, so this is arithmetic rather than a re-sort of the source data - a
  // slider move costs one pass over 609 rows.
  //
  // A component with no reading is left OUT of the weighted mean rather than scored
  // zero, and the remaining weights are renormalised over what is present. Scoring the
  // absence would rank a company by how much data exists about it: 53% of utilities
  // have no DCF reading, and they would all sink together for a reason that is about
  // the model rather than about them.
  // Mirrors build.py: a weighted GEOMETRIC mean of the legs, so one strong leg cannot
  // pay for a weak one, and the drift leg is the geometric mean of the gap and the
  // estimate change, so falling estimates cannot score as "price behind".
  var P_FLOOR = 0.005;
  function driftLeg(r) {
    if (r.pDrift === null || r.pDrift === undefined) return null;
    if (r.pRev === null || r.pRev === undefined) return r.pDrift;
    return Math.sqrt(Math.max(r.pDrift, P_FLOOR) * Math.max(r.pRev, P_FLOOR));
  }
  // ONE function scores a set of legs at the current weights. The table, the day-one
  // score and the forward test's event scores all call it, so adding a leg is one
  // edit rather than three that can disagree.
  function scoreOf(h) {
    var num = 0, den = 0;
    [[W.strain, h.pStrain], [W.drift, driftLeg(h)], [W.dcf, h.pDcf], [W.mom, h.pMom]].forEach(function (lw) {
      if (lw[1] === null || lw[1] === undefined || lw[0] <= 0) return;
      num += lw[0] * Math.log(Math.max(lw[1], P_FLOOR)); den += lw[0];
    });
    return den > 0 ? Math.exp(num / den) : null;
  }
  function rescore() {
    VER++;
    ROWS.forEach(function (r) { r.score = scoreOf(r) || 0; });
    var pool = ROWS.filter(function (r) { return !onlyAll.checked || r.complete; });
    var ordered = pool.slice().sort(function (a, b) {
      return b.score - a.score || a.ticker.localeCompare(b.ticker);
    });
    ROWS.forEach(function (r) { r.rank = null; });
    ordered.forEach(function (r, i) { r.rank = i + 1; });
  }

  function readWeights() {
    var raw = {};
    ["strain", "drift", "dcf", "mom"].forEach(function (k) {
      var id = "w" + k.charAt(0).toUpperCase() + k.slice(1);
      raw[k] = +document.getElementById(id).value;
    });
    var total = raw.strain + raw.drift + raw.dcf + raw.mom;
    ["strain", "drift", "dcf", "mom"].forEach(function (k) {
      var id = "w" + k.charAt(0).toUpperCase() + k.slice(1);
      W[k] = raw[k];
      document.getElementById(id + "V").textContent =
        total > 0 ? Math.round((raw[k] / total) * 100) + "%" : "-";
    });
    markHorizon();
    rescore();
    render();
    plot();
  }
  // Horizon presets (Short = the old Months, Long = the old Years). The legs work on different clocks, and averaging them evenly is
  // what left the combined score with no predictive power: measured 06/10/2026 off this
  // page's own record (live from 12/09, ~410 names a day, forward to 06/10), estimate
  // revisions ran a rank IC of about +0.3 and the DCF leg about -0.3, so at equal
  // weights they cancelled to zero. Revisions and price drift are a weeks-to-months
  // signal; a DCF ratio and accounting quality are signals about years, which three
  // weeks cannot test either way. So Months leans on drift with a share for clean
  // accounts (accrual quality is documented over 6-12 months), and Years drops drift
  // and splits value and accounts. Neither is a finding yet: re-test both on 06/01/2027
  // (hub-notes TODO), and change these numbers only from that test, not from a glance.
  //
  // Price trend joined Months on 06/10/2026 at an equal share with drift: it is the one
  // leg with a 15-year record on this universe (monthly IC +0.018 in 2011-2020 and in
  // a 2021-2026 holdout), where drift has three weeks. Over 12 months the same signal
  // is noise (IC +0.018, t 0.39), so Years leaves it out.
  //
  // Labelled by holding period (1 month / 6 months / 2 years) since 07/10/2026, and graded
  // at those horizons by the 06/01/2027 re-test (2 years at 12 months until the record is
  // long enough). The 6-month preset is a prior, not a finding: halfway, leaning on
  // accounts, the leg the literature puts at 6-12 months.
  //
  // Revised 07/10/2026. The reconstructed record (2021 onward) can only be scored on
  // revisions and momentum, so presets that weighted those two 1:1 drew IDENTICAL charts
  // (Charlie: "why does the graph not move at all between 1 month and 6 month"). The
  // split now follows the horizon each signal works at: revisions fade within weeks,
  // momentum is a 3-12 month effect. Both are priors, graded at the 06/01/2027 re-test.
  var HORIZON = {
    short:  { strain: 20, drift: 50, dcf: 0,  mom: 30 },
    medium: { strain: 30, drift: 15, dcf: 20, mom: 35 },
    long:   { strain: 50, drift: 0,  dcf: 50, mom: 0 }
  };
  var SLIDER = { strain: "wStrain", drift: "wDrift", dcf: "wDcf", mom: "wMom" };
  function setWeights(w) {
    Object.keys(SLIDER).forEach(function (k) { document.getElementById(SLIDER[k]).value = w[k]; });
    readWeights();
  }
  // A preset reads as pressed only while the sliders still say exactly what it set, so
  // touching a slider leaves no preset claiming the result. Even counts as one.
  function markHorizon() {
    document.querySelectorAll("#horizon button").forEach(function (b) {
      var p = HORIZON[b.dataset.h];
      var on = Object.keys(SLIDER).every(function (k) { return W[k] === p[k]; });
      b.setAttribute("aria-pressed", on ? "true" : "false");
    });
    var ks = Object.keys(SLIDER), even = W[ks[0]] > 0 && ks.every(function (k) { return W[k] === W[ks[0]]; });
    document.getElementById("wReset").setAttribute("aria-pressed", even ? "true" : "false");
  }
  document.querySelectorAll("#horizon button").forEach(function (b) {
    b.addEventListener("click", function () { setWeights(HORIZON[b.dataset.h]); });
  });
  // One redraw per frame while a slider is dragged; input fires far faster than that.
  var weightsQueued = false;
  function queueWeights() {
    if (weightsQueued) return;
    weightsQueued = true;
    requestAnimationFrame(function () { weightsQueued = false; readWeights(); });
  }
  ["wStrain", "wDrift", "wDcf", "wMom"].forEach(function (id) {
    document.getElementById(id).addEventListener("input", queueWeights);
  });
  document.getElementById("wReset").addEventListener("click", function () {
    ["wStrain", "wDrift", "wDcf", "wMom"].forEach(function (id) {
      document.getElementById(id).value = 35;
    });
    readWeights();
  });
  onlyAll.addEventListener("change", function () { rescore(); render(); plot(); });

  function visible() {
    var term = q.value.trim().toLowerCase();
    return ROWS.filter(function (r) {
      if (onlyAll.checked && !r.complete) return false;
      if (!term) return true;
      // Match from the START of the ticker or of a word in the name. Substring
      // matching returns Camden Property Trust for "AMD"; this is the rule the
      // other two sites already use.
      if (r.ticker.toLowerCase().indexOf(term) === 0) return true;
      return r.name.toLowerCase().split(/[^a-z0-9]+/).some(function (w) {
        return w.indexOf(term) === 0;
      });
    });
  }

  // Charlie: the three measures should say more on hover. Each says what the figure
  // is MADE OF rather than restating it - what the score was computed over, the two
  // moves the drift is the difference between, and what the model actually concluded.
  function strainTip(r) {
    return "Ranked against " + r.sector + ", on " + r.applicable +
           " of Shortfall's 6 accounting tests. 100 is the most strained.";
  }
  function driftTip(r) {
    var a = r.rev === null || r.rev === undefined ? null : r.rev;
    var b = r.pxchg === null || r.pxchg === undefined ? null : r.pxchg;
    if (a === null || b === null) return "Estimates against price over 90 days.";
    var s = (a > 0 ? "+" : "") + a.toFixed(1) + "% vs the price " +
            (b > 0 ? "+" : "") + b.toFixed(1) + "% over 90 days";
    return "Consensus earnings estimates " + s + ", so the price is " +
           (r.gap > 0 ? "behind" : r.gap < 0 ? "ahead of" : "level with") + " the estimates.";
  }
  function moveTip(r) {
    if (r.move === null) return "No price on record for this company on two days in one currency.";
    return "Share price " + (r.move > 0 ? "+" : "") + r.move.toFixed(1) + "% since first scored on " + SINCE + ".";
  }
  function trendTip(r) {
    if (r.ret_1y === null || r.ret_1y === undefined) return "No 12-month price history for this company.";
    return "Share price " + (r.ret_1y > 0 ? "+" : "") + (r.ret_1y * 100).toFixed(1) + "% over the past year.";
  }
  function dcfTip(r) {
    if (r.dcf === null) return "DCF Studio could not produce a usable value for this company.";
    return "DCF Studio values the shares at " + r.dcf.toFixed(2) + "x the price: the " + r.dcfband +
           " third of the " + N_DCF + " it can value.";
  }

  function render() {
    var rows = visible().slice().sort(function (a, b) {
      var x = a[sortKey], y = b[sortKey];
      if (x === null || x === undefined) return 1;   // no value sorts LAST both ways
      if (y === null || y === undefined) return -1;
      if (typeof x === "string") return x.localeCompare(y) * sortDir;
      return (x - y) * sortDir;
    });
    count.textContent = rows.length === ROWS.length
      ? rows.length + " companies"
      : rows.length + " of " + ROWS.length;
    clear.hidden = !q.value && picked === null;

    if (!rows.length) { tb.innerHTML = '<tr><td class="empty" colspan="' + (7 + (HAS_DCF ? 1 : 0) + (HAS_MOVES ? 1 : 0)) + '">No companies match.</td></tr>'; return; }
    tb.innerHTML = rows.map(function (r) {
      var t = encodeURIComponent(r.ticker);
      return '<tr>' +
        // The rank number takes the score's own colour, so the top of the table reads
        // green, the bottom red, and the middle stays quiet - the order is visible
        // without reading the header.
        '<td class="num rank" style="color:' + (r.rank === null ? "var(--soft)" : markColour(1 - (r.rank - 1) / Math.max(1, pool().length - 1))) + '">' + (r.rank === null ? "-" : r.rank) + "</td>" +
        '<td class="tick c-tick-cell">' + r.ticker + "</td>" +
        '<td><span class="tick-inline">' + r.ticker + '</span><span class="cname">' + r.name + "</span></td>" +
        '<td class="c-sect-cell">' + r.sector + "</td>" +
        // Tests is no longer a column of its own - it is a caveat on the score rather
        // than a measurement beside it, so it rides along as the cell's title.
        // Each figure opens the company on the site that measured it. A DCF of "-"
        // has no page behind it, so that one stays a plain dash.
        '<td class="num" title="' + strainTip(r) + '"><a class="src" href="https://charlietrenorden.com/shortfall/?q=' + t + '">' + r.strain.toFixed(0) + "</a></td>" +
        '<td class="num ' + r.reading + '" title="' + driftTip(r) + '"><a class="src" href="https://charlietrenorden.com/consensus-drift/?q=' + t + '">' +
          (r.gap > 0 ? "+" : "") + r.gap.toFixed(1) + "</a></td>" +
        (HAS_DCF ? '<td class="num c-dcf-cell dcf-' + r.dcfband + '" title="' + dcfTip(r) + '">' + (r.dcf === null
          ? '<span class="none">-</span>'
          : '<a class="src" href="https://dcf.charlietrenorden.com/' + t + '">' + r.dcf.toFixed(2) + "x</a>") + "</td>" : "") +
        // Shortfall publishes the 12-month return, so the figure opens Shortfall.
        '<td class="num c-trend-cell" title="' + trendTip(r) + '">' + (r.ret_1y === null || r.ret_1y === undefined
          ? '<span class="none">-</span>'
          : '<a class="src" href="https://charlietrenorden.com/shortfall/?q=' + t + '">' + (r.ret_1y > 0 ? "+" : "") + (r.ret_1y * 100).toFixed(0) + "%</a>") + "</td>" +
        (HAS_MOVES ? '<td class="num move c-move-cell" title="' + moveTip(r) + '">' + (r.move === null
          ? '<span class="none">-</span>'
          : (r.move > 0 ? "+" : "") + r.move.toFixed(1) + "%") + "</td>" : "") +
      "</tr>";
    }).join("");
  }

  document.querySelectorAll("thead th[data-k]").forEach(function (th) {
    th.addEventListener("click", function () {
      var k = th.dataset.k;
      // Arriving at a sort from elsewhere gives the direction someone asking for it
      // expects first; only a second click on the pressed column flips it.
      if (sortKey === k) { sortDir = -sortDir; }
      // Rank ascends first, because rank 1 is the top of the page and nobody clicking
      // "Rank" wants 609 first. The measures descend first; the text columns ascend.
      else { sortKey = k; sortDir = (k === "ticker" || k === "name" || k === "sector" || k === "rank") ? 1 : -1; }
      document.querySelectorAll("thead th[data-k]").forEach(function (o) {
        o.removeAttribute("aria-sort");
        o.querySelector(".ar").innerHTML = "&#9650;";
      });
      th.setAttribute("aria-sort", sortDir === 1 ? "ascending" : "descending");
      th.querySelector(".ar").innerHTML = sortDir === 1 ? "&#9650;" : "&#9660;";
      render();
    });
  });

  q.addEventListener("input", function () { render(); plot(); });
  clear.addEventListener("click", function () {
    q.value = ""; picked = null;
    render(); markPicked();
  });

  // A ?q= arriving from Shortfall or Consensus Drift lands on that company.
  var incoming = new URLSearchParams(location.search).get("q");
  if (incoming) q.value = incoming;

  showChart(CHART);
  setWeights(HORIZON.short);
  render();

  var btn = document.getElementById("themeBtn"), lbl = document.getElementById("themeLbl");
  function label() {
    lbl.textContent = document.documentElement.getAttribute("data-theme") === "dark" ? "Light" : "Dark";
  }
  label();
  btn.addEventListener("click", function () {
    var dark = document.documentElement.getAttribute("data-theme") === "dark";
    document.documentElement.setAttribute("data-theme", dark ? "light" : "dark");
    try { localStorage.setItem("theme", dark ? "light" : "dark"); } catch (e) {}
    label();
    if (window.crosscheckRedraw) window.crosscheckRedraw();
  });
})();
</script>
</body>
</html>
