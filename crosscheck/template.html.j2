     which quantity it holds. */
  .hshort { display: none; }
  .read { font: 500 11px/1 ui-sans-serif, system-ui, sans-serif; letter-spacing: .08em;
          text-transform: uppercase; }
  .read.behind { color: var(--behind); } .read.ahead { color: var(--ahead); }
  .read.inline { color: var(--inline); }
  /* Same hues as the gap reading, because they mean the same direction: cheaper is
     the model agreeing the price has room, dearer is the opposite. Reusing them says
     the two columns are two answers to one question rather than two scales. */
  .read.dcf-cheaper { color: var(--behind); } .read.dcf-dearer { color: var(--ahead); }
  .read.dcf-middle { color: var(--inline); }
  /* 103 of the 609 have no usable reading. Set quiet and italic, so the real bands
     read first and the absence recedes into being an absence rather than a value. */
  .none { color: var(--faint); font-style: italic; }
  .empty { padding: 2rem .7rem; color: var(--soft); }

  .foot { margin-top: 3rem; color: var(--faint); font: 400 13px/1.6 ui-sans-serif, system-ui, sans-serif; }
  .foot a { color: var(--soft); }

  @media (max-width: 720px) {
    .wrap { padding: 1.6rem 1rem 4rem; }
    h1 { font-size: 1.9rem; }
    .grid { grid-template-columns: auto repeat(3, 1fr); }
    .grid > * { padding: .5rem .45rem; }
    .cell .cn { font-size: 1.15rem; }
    .cell .cd { display: none; }
    .gh { font-size: 9px; letter-spacing: .06em; }
    col.c-sect, col.c-cap, col.c-tests, col.c-tick, col.c-dcf { display: none; }
    .c-sect-cell, .c-cap-cell, .c-tests-cell, .c-tick-cell, .c-dcf-cell { display: none; }
    col.c-name { width: 42%; }
    col.c-score { width: 17%; } col.c-gap { width: 21%; } col.c-read { width: 20%; }
    .hfull { display: none; } .hshort { display: inline; }
    thead th { font-size: 9.5px; letter-spacing: .05em; }
    .tick-inline { display: block; font-weight: 500; }
    .tick-inline + .cname { color: var(--soft); font-size: 12.5px; line-height: 1.35; }
